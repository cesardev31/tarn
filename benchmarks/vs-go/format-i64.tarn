import "string"
fn main() {
    values := [8]i64 { -1, -9, -10, -99, -100, -123456789, -1000000000000000000, -9223372036854775808 }
    var total: usize = 0
    var round = 0
    for round < 1000000 {
        for value in values {
            text := string.from_i64(value)
            total = total + text.len()
        }
        round = round + 1
    }
    print(total)
}
