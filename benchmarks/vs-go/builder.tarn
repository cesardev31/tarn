import "string"
fn main() {
    var total: usize = 0
    var round = 0
    for round < 200000 {
        var builder = string.Builder.new()
        var i: u64 = 0
        for i < 20 {
            builder.push(&"item-")
            builder.push_u64(i)
            builder.push(&",")
            i = i + 1
        }
        text := builder.finish()
        total = total + text.len()
        round = round + 1
    }
    print(total)
}
