enum Shape {
    Circle(i64)
    Rect(i64, i64)
    Empty
}
fn area(s &Shape) i64 {
    match s {
        Shape.Circle(r) => { return 3 * r * r }
        Shape.Rect(w, h) => { return w * h }
        Shape.Empty => { return 0 }
    }
}
fn main() {
    var shapes: Vec<Shape> = Vec.with_capacity(3000000)
    var i: i64 = 0
    for i < 3000000 {
        k := i % 3
        if k == 0 { shapes.push(Shape.Circle(i % 50)) } else if k == 1 { shapes.push(Shape.Rect(i % 30, i % 40)) } else { shapes.push(Shape.Empty) }
        i = i + 1
    }
    var total: i64 = 0
    var round = 0
    for round < 20 {
        for s in shapes.as_slice() { total = total + area(s) }
        round = round + 1
    }
    print(total)
}
