import "string"
fn main() {
    var total: usize = 0
    var round = 0
    for round < 200000 {
        var b = string.Builder.new()
        var i: u64 = 0
        for i < 20 {
            b.push(&"item-")
            b.push_u64(i)
            b.push(&",")
            i = i + 1
        }
        text := b.finish()
        total = total + string.split(&text, &",").len()
        round = round + 1
    }
    print(total)
}
