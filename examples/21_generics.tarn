fn identity<T>(value T) T {
    return value
}

struct Pair<A, B> {
    first  A
    second B
}

fn Pair<A, B>.swap(self) Pair<B, A> {
    return Pair{first: self.second, second: self.first}
}

fn main() {
    n := identity(42)
    p := Pair{first: "port", second: 8080}
    nothing: Option<i64> := None
    print(n)
    print(p.second)
    q := p.swap()
    print(q.first)
}
