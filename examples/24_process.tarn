import "process"
import "io"

fn swift_version() Result<string, io.Error> {
    command := process.Command.new("swiftc").arg("--version")
    output := try command.output()
    if !output.status.success() {
        return Err(io.Error.new(io.ErrorKind.OtherOs))
    }
    return output.stdout_text()
}
