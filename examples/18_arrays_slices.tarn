fn sum(values &[]i64) i64 {
    var total = 0
    for v in values {
        total = total + v
    }
    return total
}

fn main() {
    numbers := [4]i64{1, 2, 3, 4}
    print(sum(&numbers))          // array borrows as a slice
    print(sum(&numbers[1..3]))    // sub-slice
    print(numbers.len())
}
