// Streaming CSV input, deterministic JSON output; no output before validation.
import "csv"
import "console"
import "collections"
import "string"
import "json"
import "os"
struct Stats { count u64
    total f64 }
struct Row { category string
    stats Stats }
struct Error { kind string
    record u64
    offset usize }
fn read(reader &mut csv.Reader, record u64) Result<Option<Vec<string>>, Error> {
    match reader.read_record(csv.Limits.new()) {
        Ok(value) => { return Ok(value) }
        Err(error) => { match error {
            csv.Error.Io(failure) => { return Err(Error{kind: "input", record: record, offset: 0}) }
            csv.Error.Parse(failure) => { return Err(Error{kind: "csv", record: record, offset: failure.offset}) }
        } }
    }
}
fn compare(left &Row, right &Row) i32 {
    a := left.category.bytes()
    b := right.category.bytes()
    var i: usize = 0
    for i < a.len() && i < b.len() {
        if a[i] < b[i] { return -1 }
        if a[i] > b[i] { return 1 }
        i = i + 1
    }
    if a.len() < b.len() { return -1 }
    if a.len() > b.len() { return 1 }
    return 0
}
fn run() Result<string, Error> {
    var input = csv.Reader.new(console.stdin().buffered())
    var header: Vec<string>
    match try read(&mut input, 1) {
        Some(value) => { header = value }
        None => { return Err(Error{kind: "header", record: 1, offset: 0}) }
    }
    if header.len() != 2 { return Err(Error{kind: "header", record: 1, offset: 0}) }
    if !string.equal_ascii_case_insensitive(&string.trim(header.get(0)), "category") || !string.equal_ascii_case_insensitive(&string.trim(header.get(1)), "value") {
        return Err(Error{kind: "header", record: 1, offset: 0})
    }
    var counts: collections.Map<string, Stats> = collections.Map.new()
    var record: u64 = 1
    var records: u64 = 0
    for {
        record = record + 1
        var fields: Vec<string>
        match try read(&mut input, record) { Some(value) => { fields = value }
            None => { break } }
        if fields.len() == 1 && fields.get(0).is_empty() { continue }
        if records == 1000000 { return Err(Error{kind: "limit", record: record, offset: 0}) }
        if fields.len() != 2 { return Err(Error{kind: "columns", record: record, offset: 0}) }
        category := string.to_ascii_lower(&string.trim(fields.get(0)))
        var number: f64
        match string.parse_f64(&string.trim(fields.get(1))) { Some(value) => { number = value }
            None => { return Err(Error{kind: "number", record: record, offset: 0}) } }
        if counts.contains(&category) {
            stats := counts.get_mut(&category)
            total := stats.total + number
            if !string.is_finite(total) { return Err(Error{kind: "overflow", record: record, offset: 0}) }
            stats.total = total
            stats.count = stats.count + 1
        } else {
            if counts.len() == 100000 { return Err(Error{kind: "limit", record: record, offset: 0}) }
            counts.insert(category, Stats{count: 1, total: number})
        }
        records = records + 1
    }
    var rows: Vec<Row> = Vec.new()
    var entries = counts.drain()
    for entries.len() > 0 {
        match entries.pop() { Some(entry) => { rows.push(Row{category: entry.key, stats: entry.value}) }
            None => {} }
    }
    collections.sort(&mut rows, compare)
    var out = json.Writer.new()
    out.begin_object()
    out.field_u64("records", records)
    out.key("groups")
    out.begin_array()
    for row in rows.as_slice() {
        out.begin_object()
        out.field_string("category", &row.category)
        out.field_u64("count", row.stats.count)
        out.key("total")
        if !out.f64(row.stats.total) { panic("finite total invariant") }
        out.end_object()
    }
    out.end_array()
    out.end_object()
    return Ok(out.finish())
}
fn main() {
    match run() {
        Ok(text) => {
            var out = console.stdout().buffered()
            match out.write_text(&(text + "\n")) { Ok(done) => {}
                Err(error) => { os.exit(1) } }
            match out.finish() { Ok(done) => {}
                Err(error) => { os.exit(1) } }
        }
        Err(error) => {
            var writer = json.Writer.new()
            writer.begin_object()
            writer.key("error")
            writer.begin_object()
            writer.field_string("kind", &error.kind)
            writer.field_u64("record", error.record)
            writer.field_u64("offset", u64(error.offset))
            writer.end_object()
            writer.end_object()
            var out = console.stderr().buffered()
            match out.write_text(&(writer.finish() + "\n")) { Ok(done) => {}
                Err(failure) => {} }
            match out.finish() { Ok(done) => {}
                Err(failure) => {} }
            os.exit(1)
        }
    }
}
