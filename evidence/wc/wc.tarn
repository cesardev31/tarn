// Word/line counting over a byte buffer, repeated; plus recursive calls.
struct Counts {
    lines u64
    words u64
    bytes u64
}

fn is_space(b u8) bool {
    return b == u8(32) || b == u8(10) || b == u8(9)
}

fn count(text &[]u8, totals &mut Counts) {
    var in_word = false
    for i in 0..text.len() {
        b := text[i]
        if b == u8(10) { totals.lines = totals.lines + u64(1) }
        if is_space(b) {
            in_word = false
        } else if !in_word {
            in_word = true
            totals.words = totals.words + u64(1)
        }
    }
    totals.bytes = totals.bytes + u64(text.len())
}

fn fib(n i64) i64 {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

