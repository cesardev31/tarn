struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn consume(b Buffer) {
}

fn read(b &Buffer) {
}

fn main() {
    names := [2]Buffer{Buffer.new(), Buffer.new()}
    for b in &names {         // borrows: `names` stays usable
        read(b)
    }
    for b in names {          // consumes the array
        consume(b)
    }
}
