struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn consume(b Buffer) {
}

fn read(b &Buffer) {
}

enum Msg {
    Text(Buffer)
    Empty
}

fn handle(m Msg) {
    match m {
        Text(b) => consume(b)     // moves the payload out of `m`
        Empty => print(0)
    }
}
