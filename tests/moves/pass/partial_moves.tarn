struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn consume(b Buffer) {
}

fn read(b &Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn main() {
    p := Pair{first: Buffer.new(), second: Buffer.new()}
    x := p.first              // moves only `p.first`
    read(&p.second)           // the other field is still usable
    consume(p.second)
}
