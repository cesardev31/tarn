struct Buffer {
    data string
}
fn Buffer.new() Buffer {
    return Buffer{data: "resource"}
}
fn consume(b Buffer) {
}
struct Pair {
    first Buffer
    second Buffer
}
struct Nest {
    pair Pair
    tail Buffer
}
struct Deep {
    nest Nest
    tail Buffer
}
enum Choice {
    One(Buffer)
    Two(Buffer, Buffer)
}
fn main(c bool) {
    var e = Choice.One(Buffer.new())
    if c {
        e = Choice.Two(Buffer.new(), Buffer.new())
    }
    match e {
        One(x) => consume(x)
        Two(x, _) => consume(x)
    }
}
