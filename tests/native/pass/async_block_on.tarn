import "net"
struct Pair { first string
    second string }
fn consume(s string) { print(s) }
async fn value(x i32) i32 { return x + 1 }
async fn twice(pair Pair) i32 {
    a := await value(1)
    print(pair.first)
    b := await value(a)
    consume(pair.second)
    return b
}
fn main() Result<void, net.Error> {
    execution := try net.Execution.new()
    var app = net.Operation.new(&execution, twice(Pair{first: "a", second: "b"}))
    result := try execution.block_on(&mut app)
    print(result)
    return Ok(())
}
