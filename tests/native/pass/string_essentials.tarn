import "string"
fn main() {
    text := "café🙂"
    data := text.bytes()
    print(data.len())
    print(data[3])
    print(text + "!")
    print(text)
    cloned := text.clone()
    print(cloned == text)
    print("a" < "aa")
    print("z" > "é")
    print("a" <= "a")
    print("a" >= "a")
    print("a" != "b")
    print(string.contains(&text, &"é🙂"))
    print(string.starts_with(&text, &"caf"))
    print(string.ends_with(&text, &"🙂"))
    match string.find(&text, &"🙂") {
        Some(index) => { print(index) }
        None => { panic("missing match") }
    }
    match string.slice(&text, usize(3), usize(5)) {
        Some(part) => { print(part) }
        None => { panic("invalid boundary") }
    }
    match string.slice(&text, usize(4), usize(4)) {
        Some(part) => { panic("accepted continuation boundary") }
        None => { print("invalid boundary rejected") }
    }
    print(string.trim(&"\t café \r\n"))
    parts := string.split(&"a,,é,", &",")
    print(parts.len())
    for part in parts.as_slice() { print(part) }
    scalars := string.split(&text, &"")
    print(scalars.len())
    lines := string.lines(&"first\r\n\nlast\n")
    print(lines.len())
    for line in lines.as_slice() { print(line) }
    match string.parse_u16(&"65535") {
        Some(number) => { print(number) }
        None => { panic("valid port") }
    }
    match string.parse_u16(&"65536") {
        Some(number) => { panic("overflow accepted") }
        None => { print("overflow rejected") }
    }
    match string.parse_i64(&"-9223372036854775808") {
        Some(number) => { print(number) }
        None => { panic("valid minimum") }
    }
    maximum: u64 := 18446744073709551615
    print(string.from_u64(maximum))
    print(string.from_i64(i64(-9223372036854775808)))
    raw := [4]u8{240, 159, 153, 130}
    match string.from_utf8(&raw) {
        Some(value) => { print(value) }
        None => { panic("valid UTF-8") }
    }
}
