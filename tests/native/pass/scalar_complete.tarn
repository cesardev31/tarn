fn main() {
    a: i8 := -8
    count: u16 := 2
    print(a >> count)
    print(a << 1)
    b: u8 := 128
    print(b >> 7)
    print(b << 1)
    print(i8(127.9))
    print(i8(-128.9))
    print(u8(-0.5))
    print(u64(42.8))
    small: f32 := -12.9
    print(i16(small))
    top: u64 := 1
    print(top << 63)
    minimum: f64 := -9223372036854775808.0
    print(i64(minimum))
}
