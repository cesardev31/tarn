// Phase 28: bulk Vec append, unvalidated scalar-boundary string copies and
// constant divisors (checks kept only where they can fail).
fn main() {
    var bytes: Vec<u8> = Vec.new()
    bytes.extend_from_slice("héllo".bytes())
    bytes.extend_from_slice("".bytes())
    var n = 0
    for n < 300 {
        bytes.extend_from_slice("ab".bytes())
        n = n + 1
    }
    print(bytes.len())
    var numbers: Vec<i64> = Vec.new()
    data := [3]i64{5, -6, 7}
    numbers.extend_from_slice(&data)
    print(numbers.len())
    text := "añb"
    print(text.copy_range(0, 1))
    print(text.copy_range(1, 3))
    print(text.copy_range(3, 4))
    print(text.copy_range(4, 4).len())
    var x: i64 = -17
    print(x / 5)
    print(x % 5)
    print(x / -1)
}
