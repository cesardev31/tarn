import "io"
import "net"
fn server(conn net.TcpStream) Result<void, io.Error> {
    var stream = conn
    var bytes = [4]u8{0, 0, 0, 0}
    var count = usize(0)
    for count < usize(4) {
        count = count + try stream.read(&mut bytes[count..])
    }
    try stream.write_all(&bytes)
    try stream.shutdown(net.Shutdown.Write)
    return Ok(())
}
fn main() Result<void, io.Error> {
    var listener = try net.TcpListener.bind(&"127.0.0.1:0")
    address := try listener.local_addr()
    print(address.is_ipv4())
    print(address.port() > u16(0))
    client := spawn move fn() Result<[4]u8, io.Error> {
        var conn = try net.TcpStream.connect_addr(address)
        print((try conn.peer_addr()).port() == address.port())
        try conn.write_all(&[4]u8{1, 2, 3, 4})
        var bytes = [4]u8{0, 0, 0, 0}
        var offset = usize(0)
        for offset < usize(4) { offset = offset + try conn.read(&mut bytes[offset..]) }
        print(try conn.read(&mut bytes) == usize(0))
        try conn.close()
        return Ok(bytes)
    }
    accepted := try listener.accept()
    worker := spawn move fn() Result<void, io.Error> { return server(accepted) }
    try worker.join()
    echoed := try client.join()
    print(echoed[0])
    print(echoed[3])
    try listener.close()
    return Ok(())
}
