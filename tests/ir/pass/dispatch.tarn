interface Shape {
    fn area(&self) f64
}

struct Square {
    side f64
}

impl Shape for Square {
    fn area(&self) f64 {
        return self.side * self.side
    }
}

fn generic<S: Shape>(s &S) f64 {
    return s.area()
}

fn dynamic(s &any Shape) f64 {
    return s.area()
}

fn main() {
    sq := Square{side: 2.0}
    a := sq.area()
    b := generic(&sq)
    c := dynamic(&sq)
}
