interface Shape {
    fn area(&self) f64
}

struct Square {
    side f64
}

copy struct Circle {
    r f64
}

impl Shape for Square {
    fn area(&self) f64 {
        return self.side * self.side
    }
}

impl Shape for Circle {
    fn area(&self) f64 {
        return 3.14 * self.r * self.r
    }
}

fn total<S: Shape>(items &[]S) f64 {
    var sum = 0.0
    for s in items {
        sum = sum + s.area()
    }
    return sum
}

fn dynamic(s &any Shape) f64 {
    return s.area()
}

fn main() {
    sq := Square{side: 2.0}
    circles := [2]Circle{Circle{r: 1.0}, Circle{r: 2.0}}
    a := total(&circles)
    b := dynamic(&sq)
    c := Square.area(&sq)
    print(a + b + c)
}
