struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn read(b &Buffer) {
}

fn write(b &mut Buffer) {
}

fn consume(b Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn Pair.new() Pair {
    return Pair{first: Buffer.new(), second: Buffer.new()}
}

fn main(n i64) {
    var x = Buffer.new()
    for i in 0..n {
        r := &mut x
        write(r)
        if i == 1 {
            continue          // `r` is no longer used: the loan ended
        }
        read(&x)
    }
}
