struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn read(b &Buffer) {
}

fn write(b &mut Buffer) {
}

fn consume(b Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn Pair.new() Pair {
    return Pair{first: Buffer.new(), second: Buffer.new()}
}

struct Counter {
    value i64
}

fn Counter.add(&mut self, n i64) {
    self.value = self.value + n
}

fn main() {
    var c = Counter{value: 1}
    c.add(c.value)            // the argument is read before `&mut c` exists
}
