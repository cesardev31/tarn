struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn read(b &Buffer) {
}

fn write(b &mut Buffer) {
}

fn consume(b Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn Pair.new() Pair {
    return Pair{first: Buffer.new(), second: Buffer.new()}
}

fn first(x &string) &string {
    return x
}

fn field(b &Buffer) &string {
    return &b.data
}

fn longest(a &string, b &string) &string {
    if a.len() >= b.len() {
        return a
    }
    return b
}

fn pick_left(a &string, b &string) &string {
    return a
}

fn main() {
    var x = "short"
    var y = "longer"
    r := pick_left(&x, &y)
    y = "changed"             // `r` only borrows `x` (provenance {a})
    print(r)
}
