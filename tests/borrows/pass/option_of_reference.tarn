struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn read(b &Buffer) {
}

fn write(b &mut Buffer) {
}

fn consume(b Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn Pair.new() Pair {
    return Pair{first: Buffer.new(), second: Buffer.new()}
}

fn find(items &[]Buffer) Option<&Buffer> {
    if items.is_empty() {
        return None
    }
    return Some(&items[0])
}

fn main() {
    var items = [2]Buffer{Buffer.new(), Buffer.new()}
    match find(&items) {
        Some(b) => read(b)
        None => print(0)
    }
    write(&mut items[0])      // the result was last used in the match
}
