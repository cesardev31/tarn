struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn read(b &Buffer) {
}

fn write(b &mut Buffer) {
}

fn consume(b Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn Pair.new() Pair {
    return Pair{first: Buffer.new(), second: Buffer.new()}
}

// Non-lexical: `r` is never used after `read(r)`, so its loan ends there.
fn main() {
    var x = Buffer.new()
    r := &x
    read(r)
    write(&mut x)
}
