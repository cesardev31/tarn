struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn read(b &Buffer) {
}

fn write(b &mut Buffer) {
}

fn consume(b Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn Pair.new() Pair {
    return Pair{first: Buffer.new(), second: Buffer.new()}
}

fn main(c bool) {
    var x = Buffer.new()
    if c {
        m := &mut x
        write(m)
    } else {
        s := &x
        read(s)
    }
    write(&mut x)
}
