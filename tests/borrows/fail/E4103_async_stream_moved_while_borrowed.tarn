import "io"
import "runtime"
import "net"
async fn get(stream &mut net.TcpStream) Result<usize, io.Error> {
    var bytes = [1]u8{0}
    return await stream.read_async(&mut bytes)
}
fn main() Result<void, io.Error> {
    var listener = try net.TcpListener.bind(&"127.0.0.1:0")
    var stream = try net.TcpStream.connect_addr(try listener.local_addr())
    computation := get(&mut stream)
    moved := stream
    execution := try runtime.Execution.new()
    var op = runtime.Operation.new(&execution, computation)
    count := try try execution.block_on(&mut op)
    return Ok(())
}
