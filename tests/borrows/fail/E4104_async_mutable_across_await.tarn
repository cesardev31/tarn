import "net"
struct Buffer { len usize }
fn pause(owner &net.Execution) net.Operation<void> {
    var polled = false
    return net.Operation.new(owner, move fn(waker &net.Waker) net.Progress<void> {
        if polled { return net.Progress.Ready(()) }
        polled = true
        waker.wake()
        return net.Progress.Pending
    })
}
// Suspension does not end a mutable loan that is used after resumption.
async fn f(owner &net.Execution) {
    var b = Buffer{len: usize(3)}
    r := &mut b
    await pause(owner)
    print(b.len)
    r.len = usize(1)
}
fn main() {}
