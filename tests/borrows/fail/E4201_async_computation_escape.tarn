import "net"
struct Buffer { len usize }
fn pause(owner &net.Execution) net.Operation<void> {
    var polled = false
    return net.Operation.new(owner, move fn(waker &net.Waker) net.Progress<void> {
        if polled { return net.Progress.Ready(()) }
        polled = true
        waker.wake()
        return net.Progress.Pending
    })
}
// A computation cannot outlive the local storage it borrows.
async fn fill(owner &net.Execution, buffer &mut Buffer) usize {
    await pause(owner)
    return buffer.len
}
fn make(owner &net.Execution) net.Operation<usize> {
    var b = Buffer{len: usize(0)}
    return net.Operation.new(owner, fill(owner, &mut b))
}
fn main() {}
