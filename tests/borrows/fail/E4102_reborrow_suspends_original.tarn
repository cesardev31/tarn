struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn read(b &Buffer) {
}

fn write(b &mut Buffer) {
}

fn consume(b Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn Pair.new() Pair {
    return Pair{first: Buffer.new(), second: Buffer.new()}
}

struct Counter {
    value i64
}

fn bump(c &mut Counter) {
    r := &mut c.value
    c.value = 1               // writing through `c` while `r` still borrows it
    print(r)
}
