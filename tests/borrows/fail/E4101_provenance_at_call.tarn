struct Buffer {
    data string
}

fn Buffer.new() Buffer {
    return Buffer{data: ""}
}

fn read(b &Buffer) {
}

fn write(b &mut Buffer) {
}

fn consume(b Buffer) {
}

struct Pair {
    first Buffer
    second Buffer
}

fn Pair.new() Pair {
    return Pair{first: Buffer.new(), second: Buffer.new()}
}

fn longest(a &string, b &string) &string {
    if a.len() >= b.len() {
        return a
    }
    return b
}

fn main() {
    var x = "short"
    var y = "longer"
    r := longest(&x, &y)
    m := &mut y               // `r` may borrow `y` (provenance {a, b})
    print(r)
}
