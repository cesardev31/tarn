// Blocking, non-owning standard descriptor views (ADR 0060). Never close them.
import "io"
import "ffi"
extern "C" fn read(fd i32, data *mut u8, count usize) i64
extern "C" fn tarn_console_write(fd i32, data *u8, count usize) i64
extern "C" fn tarn_console_flush() i32
extern "C" fn __errno_location() *u8

pub struct Input { fd i32 }
pub struct Output { fd i32 }
pub fn stdin() Input { return Input{fd: 0} }
pub fn stdout() Output { return Output{fd: 1} }
pub fn stderr() Output { return Output{fd: 2} }
fn _error() io.Error {
    var data: Vec<u8> = Vec.new()
    unsafe { data = ffi.copy_bytes(__errno_location(), 4) }
    code := i32(data.at(0)) + i32(data.at(1)) * 256 + i32(data.at(2)) * 65536 + i32(data.at(3)) * 16777216
    return io.Error.from_os(code)
}
/// One read; zero is EOF (or an empty buffer). Retries EINTR only.
pub fn Input.read(&mut self, buffer &mut []u8) Result<usize, io.Error> {
    for {
        var count: i64 = 0
        unsafe { count = read(self.fd, ffi.slice_mut(buffer), buffer.len()) }
        if count >= 0 { return Ok(usize(count)) }
        error := _error()
        if error.native_code() != 4 { return Err(error) }
    }
}
/// One write, which may be partial. Retries EINTR only.
pub fn Output.write(&mut self, buffer &[]u8) Result<usize, io.Error> {
    for {
        var count: i64 = 0
        unsafe { count = tarn_console_write(self.fd, ffi.slice(buffer), buffer.len()) }
        if count >= 0 { return Ok(usize(count)) }
        error := _error()
        if error.native_code() != 4 { return Err(error) }
    }
}
pub fn Output.write_all(&mut self, buffer &[]u8) Result<void, io.Error> {
    var offset: usize = 0
    for offset < buffer.len() {
        count := try self.write(&buffer[offset..])
        if count == 0 { return Err(io.Error.new(io.ErrorKind.WriteZero)) }
        offset = offset + count
    }
    return Ok(())
}
pub fn Output.write_text(&mut self, text &string) Result<void, io.Error> { return self.write_all(text.bytes()) }
/// Tarn writes are unbuffered. Flush all libc output streams, including print.
/// Call before mixing print with unbuffered writes when order matters.
pub fn Output.flush(&mut self) Result<void, io.Error> {
    var code: i32 = 0
    unsafe { code = tarn_console_flush() }
    if code != 0 { return Err(_error()) }
    return Ok(())
}


/// Owned buffering state over a non-owning standard descriptor. Destruction
/// discards buffered data; it never reads, writes or closes a descriptor.
pub struct LineReader { input Input
    buffer Vec<u8>
    start usize
    end usize
    eof bool
    failed bool }
pub fn Input.buffered(self) LineReader {
    var buffer: Vec<u8> = Vec.with_capacity(4096)
    for buffer.len() < 4096 { buffer.push(0) }
    return LineReader{input: self, buffer: buffer, start: 0, end: 0, eof: false, failed: false}
}
/// UTF-8 line without LF/CRLF; EOF is None, including after a final terminator.
/// limit counts returned bytes, maximum 64 MiB. Any error poisons this reader;
/// subsequent reads return InvalidData. A bare final CR remains text.
pub fn LineReader.read_line(&mut self, limit usize) Result<Option<string>, io.Error> {
    if self.failed { return Err(io.Error.new(io.ErrorKind.InvalidData)) }
    if limit > 67108864 { self.failed = true
        return Err(io.Error.new(io.ErrorKind.InvalidInput)) }
    var line: Vec<u8> = Vec.new()
    for {
        if self.start == self.end && !self.eof {
            match self.input.read(self.buffer.as_mut_slice()) {
                Ok(count) => { self.start = 0
                    self.end = count
                    self.eof = count == 0 }
                Err(error) => { self.failed = true
                    return Err(error) }
            }
        }
        if self.start == self.end && self.eof {
            if line.is_empty() { return Ok(None) }
            if line.len() > limit { self.failed = true
                return Err(io.Error.new(io.ErrorKind.LimitExceeded)) }
            break
        }
        byte := self.buffer.at(self.start)
        self.start = self.start + 1
        if byte == 10 {
            if line.len() > 0 && line.at(line.len() - 1) == 13 { line.pop() }
            break
        }
        // One pending CR beyond the bound is permitted only if followed by LF.
        if line.len() > limit || (line.len() == limit && byte != 13) {
            self.failed = true
            return Err(io.Error.new(io.ErrorKind.LimitExceeded))
        }
        line.push(byte)
    }
    match string_from_utf8(line.as_slice()) { Some(text) => { return Ok(Some(text)) }
        None => { self.failed = true
            return Err(io.Error.new(io.ErrorKind.InvalidData)) } }
}
pub struct BufferedOutput { output Output
    data Vec<u8>
    sent usize }
pub fn Output.buffered(self) BufferedOutput { return BufferedOutput{output: self, data: Vec.with_capacity(4096), sent: 0} }
/// Bytes may be buffered or transmitted. Explicit flush/finish is required.
pub fn BufferedOutput.write_all(&mut self, bytes &[]u8) Result<void, io.Error> {
    var offset: usize = 0
    for offset < bytes.len() {
        if self.data.len() == 4096 { try self.flush() }
        var count = bytes.len() - offset
        if count > 4096 - self.data.len() { count = 4096 - self.data.len() }
        self.data.extend_from_slice(&bytes[offset..offset + count])
        offset = offset + count
    }
    return Ok(())
}
pub fn BufferedOutput.write_text(&mut self, text &string) Result<void, io.Error> { return self.write_all(text.bytes()) }
/// Successful partial writes are retained in sent; retrying flush never sends
/// them again. libc flush errors propagate even after all Tarn bytes were sent.
pub fn BufferedOutput.flush(&mut self) Result<void, io.Error> {
    for self.sent < self.data.len() {
        count := try self.output.write(&self.data.as_slice()[self.sent..])
        if count == 0 { return Err(io.Error.new(io.ErrorKind.WriteZero)) }
        self.sent = self.sent + count
    }
    for self.data.len() > 0 { self.data.pop() }
    self.sent = 0
    return self.output.flush()
}
pub fn BufferedOutput.finish(self) Result<void, io.Error> {
    var writer = self
    return writer.flush()
}
