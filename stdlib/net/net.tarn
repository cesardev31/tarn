// Blocking and explicit nonblocking Linux networking. Opaque descriptors are owned, Transfer, not Share.
import "io"
// Blocking and explicit nonblocking Linux networking. Opaque descriptors are owned, Transfer, not Share.
pub struct TcpListener { fd i32 }
pub struct TcpStream { fd i32 }
pub struct UdpSocket { fd i32 }
pub copy struct SocketAddr { data [24]u8 }
pub copy enum IpAddr {
    V4([4]u8)
    V6([16]u8)
}
pub copy enum Shutdown {
    Read
    Write
    Both
}
pub copy struct RecvFrom {
    pub count usize
    pub peer SocketAddr
}
extern "intrinsic" fn _resolve(address &string) io._Raw
extern "intrinsic" fn _socket(address SocketAddr, udp bool) io._Raw
extern "intrinsic" fn _bind(fd i32, address SocketAddr) io._Raw
extern "intrinsic" fn _listen(fd i32) io._Raw
extern "intrinsic" fn _accept(fd i32) io._Raw
extern "intrinsic" fn _connect(fd i32, address SocketAddr) io._Raw
extern "intrinsic" fn _read(fd i32, buffer &mut []u8) io._Raw
extern "intrinsic" fn _write(fd i32, buffer &[]u8) io._Raw
extern "intrinsic" fn _recv(fd i32, buffer &mut []u8) io._Raw
extern "intrinsic" fn _send(fd i32, buffer &[]u8, address SocketAddr) io._Raw
extern "intrinsic" fn _addr(fd i32, peer bool) io._Raw
extern "intrinsic" fn _shutdown(fd i32, how i32) io._Raw
extern "intrinsic" fn _close_listener(value TcpListener) io._Raw
extern "intrinsic" fn _close_stream(value TcpStream) io._Raw
extern "intrinsic" fn _close_udp(value UdpSocket) io._Raw
pub fn SocketAddr.port(&self) u16 { return u16(self.data[16]) * 256 + u16(self.data[17]) }
pub fn SocketAddr.is_ipv4(&self) bool { return self.data[18] == 4 }
pub fn SocketAddr.is_ipv6(&self) bool { return self.data[18] == 6 }
pub fn SocketAddr.with_port(self, port u16) SocketAddr {
    var result = self
    result.data[16] = u8(port / 256)
    result.data[17] = u8(port % 256)
    return result
}
pub fn SocketAddr.ip(&self) IpAddr {
    if self.is_ipv4() { return IpAddr.V4([4]u8{self.data[0], self.data[1], self.data[2], self.data[3]}) }
    return IpAddr.V6([16]u8{self.data[0], self.data[1], self.data[2], self.data[3], self.data[4], self.data[5], self.data[6], self.data[7], self.data[8], self.data[9], self.data[10], self.data[11], self.data[12], self.data[13], self.data[14], self.data[15]})
}
pub fn resolve(address &string) Result<SocketAddr, io.Error> {
    for {
        raw := _resolve(address)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try io._check(raw)
        return Ok(SocketAddr{data: checked.address})
    }
}
pub fn listen_tcp(address &string) Result<TcpListener, io.Error> { return TcpListener.bind(address) }
pub fn TcpListener.bind(address &string) Result<TcpListener, io.Error> { return TcpListener.bind_addr(try resolve(address)) }
pub fn TcpListener.bind_addr(address SocketAddr) Result<TcpListener, io.Error> {
    raw := try _open(address, false)
    listener := TcpListener{fd: i32(raw.value)}
    try _bound(listener.fd, address)
    try _listening(listener.fd)
    return Ok(listener)
}
pub fn TcpListener.accept(&mut self) Result<TcpStream, io.Error> {
    for {
        raw := _accept(self.fd)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(TcpStream{fd: i32(checked.value)})
    }
}
pub fn TcpStream.connect(address &string) Result<TcpStream, io.Error> { return TcpStream.connect_addr(try resolve(address)) }
pub fn TcpStream.connect_addr(address SocketAddr) Result<TcpStream, io.Error> {
    for {
        raw := try _open(address, false)
        stream := TcpStream{fd: i32(raw.value)}
        status := _connect(stream.fd, address)
        if status.code == 4 && status.domain == 0 { continue }
        try io._check(status)
        return Ok(stream)
    }
}
pub fn TcpStream.write_all(&mut self, buffer &[]u8) Result<void, io.Error> {
    for {
        mode := _mode(self.fd)
        if mode.code == 4 && mode.domain == 0 { continue }
        checked := try io._check(mode)
        if checked.value != 0 { return Err(io.Error{kind: io.ErrorKind.WouldBlock, code: 11, domain: 0}) }
        break
    }
    var offset = usize(0)
    for offset < buffer.len() {
        count := try self.write(&buffer[offset..])
        if count == 0 { return Err(io.Error{kind: io.ErrorKind.WriteZero, code: 0, domain: 0}) }
        offset = offset + count
    }
    return Ok(())
}
pub fn TcpStream.shutdown(&mut self, how Shutdown) Result<void, io.Error> {
    var direction = i32(2)
    match how {
        Shutdown.Read => { direction = 0 }
        Shutdown.Write => { direction = 1 }
        Shutdown.Both => {}
    }
    for {
        raw := _shutdown(self.fd, direction)
        if raw.code == 4 && raw.domain == 0 { continue }
        try io._check(raw)
        return Ok(())
    }
}
pub fn UdpSocket.bind(address &string) Result<UdpSocket, io.Error> { return UdpSocket.bind_addr(try resolve(address)) }
pub fn UdpSocket.bind_addr(address SocketAddr) Result<UdpSocket, io.Error> {
    raw := try _open(address, true)
    socket := UdpSocket{fd: i32(raw.value)}
    try _bound(socket.fd, address)
    return Ok(socket)
}
pub fn UdpSocket.recv_from(&mut self, buffer &mut []u8) Result<RecvFrom, io.Error> {
    for {
        raw := _recv(self.fd, buffer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(RecvFrom{count: usize(checked.value), peer: SocketAddr{data: checked.address}})
    }
}
pub fn UdpSocket.send_to(&mut self, buffer &[]u8, peer SocketAddr) Result<usize, io.Error> {
    for {
        raw := _send(self.fd, buffer, peer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(usize(checked.value))
    }
}
pub fn TcpListener.local_addr(&self) Result<SocketAddr, io.Error> {
    for {
        raw := _addr(self.fd, false)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(SocketAddr{data: checked.address})
    }
}
pub fn TcpListener.close(self) Result<void, io.Error> {
    try io._check(_close_listener(self))
    return Ok(())
}
pub fn TcpStream.local_addr(&self) Result<SocketAddr, io.Error> {
    for {
        raw := _addr(self.fd, false)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(SocketAddr{data: checked.address})
    }
}
pub fn TcpStream.peer_addr(&self) Result<SocketAddr, io.Error> {
    for {
        raw := _addr(self.fd, true)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(SocketAddr{data: checked.address})
    }
}
pub fn TcpStream.close(self) Result<void, io.Error> {
    try io._check(_close_stream(self))
    return Ok(())
}
pub fn UdpSocket.local_addr(&self) Result<SocketAddr, io.Error> {
    for {
        raw := _addr(self.fd, false)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(SocketAddr{data: checked.address})
    }
}
pub fn UdpSocket.close(self) Result<void, io.Error> {
    try io._check(_close_udp(self))
    return Ok(())
}
pub fn TcpStream.read(&mut self, buffer &mut []u8) Result<usize, io.Error> {
    for {
        raw := _read(self.fd, buffer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(usize(checked.value))
    }
}
pub fn TcpStream.write(&mut self, buffer &[]u8) Result<usize, io.Error> {
    for {
        raw := _write(self.fd, buffer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(usize(checked.value))
    }
}
fn _open(address SocketAddr, udp bool) Result<io._Raw, io.Error> {
    for {
        raw := _socket(address, udp)
        if raw.code == 4 && raw.domain == 0 { continue }
        return io._check(raw)
    }
}
fn _bound(fd i32, address SocketAddr) Result<void, io.Error> {
    for {
        raw := _bind(fd, address)
        if raw.code == 4 && raw.domain == 0 { continue }
        try io._check(raw)
        return Ok(())
    }
}
fn _listening(fd i32) Result<void, io.Error> {
    for {
        raw := _listen(fd)
        if raw.code == 4 && raw.domain == 0 { continue }
        try io._check(raw)
        return Ok(())
    }
}
// Level-triggered readiness. Tokens are observations, never socket authority.
pub struct Poll { handle usize }
pub copy struct Token { value u64 }
pub copy enum Interest {
    Readable
    Writable
    ReadableWritable
}
pub copy struct Event {
    pub token Token
    pub readable bool
    pub writable bool
    pub error bool
    pub hangup bool
}
pub struct Connecting {
    stream TcpStream
    status i32
}
extern "intrinsic" fn _nonblocking(fd i32, enabled bool) io._Raw
extern "intrinsic" fn _mode(fd i32) io._Raw
extern "intrinsic" fn _connected(fd i32) io._Raw
extern "intrinsic" fn _poll_new() io._Raw
extern "intrinsic" fn _poll_ctl(handle usize, fd i32, operation i32, interest i32, token u64) io._Raw
extern "intrinsic" fn _poll_wait(handle usize, events &mut []Event, timeout i32) io._Raw
extern "intrinsic" fn _close_poll(value Poll) io._Raw
pub fn Event.empty() Event {
    return Event{token: Token{value: 0}, readable: false, writable: false, error: false, hangup: false}
}
pub fn Token.same(self, other Token) bool { return self.value == other.value }
fn _set_nonblocking(fd i32, enabled bool) Result<void, io.Error> {
    for {
        raw := _nonblocking(fd, enabled)
        if raw.code == 4 && raw.domain == 0 { continue }
        try io._check(raw)
        return Ok(())
    }
}
pub fn TcpListener.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return _set_nonblocking(self.fd, enabled) }
pub fn TcpStream.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return _set_nonblocking(self.fd, enabled) }
pub fn UdpSocket.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return _set_nonblocking(self.fd, enabled) }
pub fn TcpStream.connect_nonblocking(address &string) Result<Connecting, io.Error> { return TcpStream.connect_nonblocking_addr(try resolve(address)) }
pub fn TcpStream.connect_nonblocking_addr(address SocketAddr) Result<Connecting, io.Error> {
    raw := try _open(address, false)
    var stream = TcpStream{fd: i32(raw.value)}
    try stream.set_nonblocking(true)
    status := _connect(stream.fd, address)
    if status.domain == 0 && (status.code == 115 || status.code == 4) {
        return Ok(Connecting{stream: stream, status: 115})
    }
    try io._check(status)
    return Ok(Connecting{stream: stream, status: 0})
}
pub fn Connecting.poll_connected(&mut self) Result<bool, io.Error> {
    if self.status == 0 { return Ok(true) }
    if self.status != 115 { return Err(_connection_error(self.status)) }
    for {
        raw := _connected(self.stream.fd)
        if raw.domain == 0 && raw.code == 4 { continue }
        if raw.domain == 0 && raw.code == 11 { return Ok(false) }
        self.status = raw.code
        try io._check(raw)
        return Ok(true)
    }
}
pub fn Connecting.into_stream(self) Result<TcpStream, io.Error> {
    if self.status != 0 { return Err(_connection_error(self.status)) }
    return Ok(self.stream)
}
pub fn Poll.new() Result<Poll, io.Error> {
    for {
        raw := _poll_new()
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try io._check(raw)
        return Ok(Poll{handle: usize(checked.value)})
    }
}
fn _interest(value Interest) i32 {
    match value {
        Interest.Readable => { return 1 }
        Interest.Writable => { return 2 }
        Interest.ReadableWritable => { return 3 }
    }
}
fn _registration(handle usize, fd i32, op i32, interest Interest, token Token) Result<Token, io.Error> {
    for {
        raw := _poll_ctl(handle, fd, op, _interest(interest), token.value)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try io._check(raw)
        return Ok(Token{value: u64(checked.value)})
    }
}
pub fn Poll.register_listener(&mut self, socket &TcpListener, interest Interest) Result<Token, io.Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: 0}) }
pub fn Poll.register_stream(&mut self, socket &TcpStream, interest Interest) Result<Token, io.Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: 0}) }
pub fn Poll.register_udp(&mut self, socket &UdpSocket, interest Interest) Result<Token, io.Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: 0}) }
pub fn Poll.register_connecting(&mut self, socket &Connecting) Result<Token, io.Error> { return _registration(self.handle, socket.stream.fd, 0, Interest.Writable, Token{value: 0}) }
pub fn Poll.modify_listener(&mut self, socket &TcpListener, token Token, interest Interest) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 1, interest, token)
    return Ok(())
}
pub fn Poll.modify_stream(&mut self, socket &TcpStream, token Token, interest Interest) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 1, interest, token)
    return Ok(())
}
pub fn Poll.modify_udp(&mut self, socket &UdpSocket, token Token, interest Interest) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 1, interest, token)
    return Ok(())
}
pub fn Poll.deregister_listener(&mut self, socket &TcpListener, token Token) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.deregister_stream(&mut self, socket &TcpStream, token Token) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.deregister_udp(&mut self, socket &UdpSocket, token Token) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.deregister_connecting(&mut self, socket &Connecting, token Token) Result<void, io.Error> {
    try _registration(self.handle, socket.stream.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.wait(&mut self, events &mut []Event, timeout i32) Result<usize, io.Error> {
    if timeout < -1 || events.len() == 0 { return Err(io.Error{kind: io.ErrorKind.InvalidAddress, code: 22, domain: 0}) }
    var remaining = timeout
    var deadline = i64(0)
    if timeout > 0 { deadline = (try io._check(io._now())).value + i64(timeout) }
    for {
        raw := _poll_wait(self.handle, events, remaining)
        if raw.domain == 0 && raw.code == 4 {
            if timeout > 0 {
                now := (try io._check(io._now())).value
                if now >= deadline { return Ok(0) }
                remaining = i32(deadline - now)
            }
            continue
        }
        checked := try io._check(raw)
        return Ok(usize(checked.value))
    }
}
pub fn Poll.close(self) Result<void, io.Error> {
    try io._check(_close_poll(self))
    return Ok(())
}
fn _connection_error(code i32) io.Error {
    var kind = io.ErrorKind.OtherOs
    if code == 115 { kind = io.ErrorKind.WouldBlock }
    if code == 111 { kind = io.ErrorKind.ConnectionRefused }
    if code == 104 { kind = io.ErrorKind.ConnectionReset }
    if code == 110 { kind = io.ErrorKind.TimedOut }
    return io.Error{kind: kind, code: code, domain: 0}
}
fn _require_nonblocking(fd i32) Result<void, io.Error> {
    for {
        raw := _mode(fd)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try io._check(raw)
        if checked.value == 0 { return Err(io.Error{kind: io.ErrorKind.InvalidAddress, code: 22, domain: 0}) }
        return Ok(())
    }
}
pub fn poll_read(waker &io.Waker, stream &mut TcpStream, buffer &mut []u8) io.Progress<Result<usize, io.Error>> {
    match _require_nonblocking(stream.fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.read(buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, stream.fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.read(buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
pub fn poll_write(waker &io.Waker, stream &mut TcpStream, buffer &[]u8) io.Progress<Result<usize, io.Error>> {
    match _require_nonblocking(stream.fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.write(buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, stream.fd, 2) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.write(buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
pub fn poll_accept(waker &io.Waker, listener &mut TcpListener) io.Progress<Result<TcpStream, io.Error>> {
    match _require_nonblocking(listener.fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match listener.accept() {
        Ok(stream) => { return io.Progress.Ready(Ok(stream)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, listener.fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match listener.accept() {
        Ok(stream) => { return io.Progress.Ready(Ok(stream)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
pub fn poll_connect(waker &io.Waker, connecting &mut Connecting) io.Progress<Result<void, io.Error>> {
    match connecting.poll_connected() {
        Ok(complete) => { if complete { return io.Progress.Ready(Ok(())) } }
        Err(error) => { return io.Progress.Ready(Err(error)) }
    }
    match io._arm(waker, connecting.stream.fd, 2) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match connecting.poll_connected() {
        Ok(complete) => { if complete { return io.Progress.Ready(Ok(())) } }
        Err(error) => { return io.Progress.Ready(Err(error)) }
    }
    return io.Progress.Pending
}
pub fn poll_recv(waker &io.Waker, socket &mut UdpSocket, buffer &mut []u8) io.Progress<Result<RecvFrom, io.Error>> {
    match _require_nonblocking(socket.fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match socket.recv_from(buffer) {
        Ok(packet) => { return io.Progress.Ready(Ok(packet)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, socket.fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match socket.recv_from(buffer) {
        Ok(packet) => { return io.Progress.Ready(Ok(packet)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
// Explicit async I/O over the Phase-12C poll functions. Blocking methods keep
// their names and behavior; these never block the executor. They require
// nonblocking sockets, exactly like the manual operations.
pub async fn TcpStream.read_async(&mut self, buffer &mut []u8) Result<usize, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> { return io._leaf(waker, poll_read(waker, self, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn TcpStream.write_async(&mut self, buffer &[]u8) Result<usize, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> { return io._leaf(waker, poll_write(waker, self, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
// At most one successful write per poll; partial progress wakes the same
// Waker before parking, so the next executor turn continues (fairness).
pub async fn TcpStream.write_all_async(&mut self, buffer &[]u8) Result<void, io.Error> {
    var offset = usize(0)
    for {
        if offset == buffer.len() { return Ok(()) }
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> {
            match io._leaf(waker, poll_write(waker, self, &buffer[offset..])) {
                io.Progress.Ready(result) => match result {
                    Ok(count) => {
                        if count != 0 && offset + count != buffer.len() { io._wake(waker) }
                        return io.Progress.Ready(Ok(count))
                    }
                    Err(error) => { return io.Progress.Ready(Err(error)) }
                }
                io.Progress.Pending => { return io.Progress.Pending }
            }
        }) {
            io.Progress.Ready(result) => {
                count := try result
                if count == 0 { return Err(io.Error{kind: io.ErrorKind.WriteZero, code: 0, domain: 0}) }
                offset = offset + count
            }
            io.Progress.Pending => {}
        }
        if offset != buffer.len() { io._async_park() }
    }
}
pub async fn TcpListener.accept_async(&mut self) Result<TcpStream, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<TcpStream, io.Error>> { return io._leaf(waker, poll_accept(waker, self)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn Connecting.finish_async(&mut self) Result<void, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<void, io.Error>> { return io._leaf(waker, poll_connect(waker, self)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn UdpSocket.recv_from_async(&mut self, buffer &mut []u8) Result<RecvFrom, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<RecvFrom, io.Error>> { return io._leaf(waker, poll_recv(waker, self, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
fn _zero_fill(buffer &mut Vec<u8>, size usize) {
    for {
        if buffer.len() >= size { return }
        buffer.push(0)
    }
}
fn _copy_bytes(target &mut []u8, source &[]u8) {
    var index = usize(0)
    for {
        if index == source.len() { return }
        target[index] = source[index]
        index = index + 1
    }
}
/// Owned read buffer. Buffered bytes are `buffer[start..end]`.
pub struct BufferedReader {
    buffer Vec<u8>
    start usize
    end usize
}
/// A zero capacity aborts.
pub fn BufferedReader.new(capacity usize) BufferedReader {
    if capacity == 0 { panic("buffer capacity must be positive") }
    var buffer = Vec.new()
    _zero_fill(&mut buffer, capacity)
    return BufferedReader{buffer: buffer, start: 0, end: 0}
}
pub fn BufferedReader.buffered(&self) usize { return self.end - self.start }
pub fn BufferedReader.capacity(&self) usize { return self.buffer.len() }
// Make room after `end`: reuse an empty buffer, move unread bytes to the
// front, or grow geometrically when the buffer is full of unread bytes.
fn BufferedReader._reserve(&mut self) {
    if self.start == self.end {
        self.start = 0
        self.end = 0
    }
    if self.end != self.buffer.len() { return }
    start := self.start
    count := self.end - start
    if start == 0 {
        size := self.buffer.len() * 2
        _zero_fill(&mut self.buffer, size)
        return
    }
    data := self.buffer.as_mut_slice()
    var index = usize(0)
    for {
        if index == count { break }
        data[index] = data[start + index]
        index = index + 1
    }
    self.start = 0
    self.end = count
}
// One read into free space; Ok(0) is end of stream.
async fn BufferedReader._fill(&mut self, stream &mut TcpStream) Result<usize, io.Error> {
    self._reserve()
    end := self.end
    count := try await stream.read_async(&mut self.buffer.as_mut_slice()[end..])
    self.end = end + count
    return Ok(count)
}
fn BufferedReader._take(&mut self, target &mut []u8) usize {
    start := self.start
    var count = self.end - start
    if target.len() < count { count = target.len() }
    _copy_bytes(target, &self.buffer.as_slice()[start..start + count])
    self.start = start + count
    return count
}
fn BufferedReader._split(&mut self, end usize) Vec<u8> {
    var line = Vec.new()
    var index = self.start
    for {
        if index == end { break }
        line.push(self.buffer.at(index))
        index = index + 1
    }
    self.start = end
    return line
}
/// Buffered bytes first; otherwise at most one read. A request at least as
/// large as the buffer bypasses it. Ok(0) is end of stream.
pub async fn BufferedReader.read(&mut self, stream &mut TcpStream, target &mut []u8) Result<usize, io.Error> {
    if target.len() == 0 { return Ok(0) }
    if self.start == self.end {
        if target.len() >= self.buffer.len() { return await stream.read_async(target) }
        count := try await self._fill(stream)
        if count == 0 { return Ok(0) }
    }
    return Ok(self._take(target))
}
/// Fills `target` completely. End of stream first is UnexpectedEof; bytes
/// already copied into `target` stay consumed.
pub async fn BufferedReader.read_exact(&mut self, stream &mut TcpStream, target &mut []u8) Result<void, io.Error> {
    var done = usize(0)
    for {
        if done == target.len() { return Ok(()) }
        if self.start == self.end {
            count := try await self._fill(stream)
            if count == 0 { return Err(io._fail(io.ErrorKind.UnexpectedEof)) }
        }
        done = done + self._take(&mut target[done..])
    }
}
/// Bytes up to and including `delimiter`, as an owned vector of at most
/// `max` bytes; a longer line is LimitExceeded and stays buffered. At end of
/// stream the remaining bytes are returned without a delimiter; an empty
/// vector means the stream had ended.
pub async fn BufferedReader.read_until(&mut self, stream &mut TcpStream, delimiter u8, max usize) Result<Vec<u8>, io.Error> {
    var scanned = usize(0)
    for {
        var index = self.start + scanned
        for {
            if index == self.end { break }
            if self.buffer.at(index) == delimiter {
                if index + 1 - self.start > max { return Err(io._fail(io.ErrorKind.LimitExceeded)) }
                return Ok(self._split(index + 1))
            }
            index = index + 1
        }
        scanned = self.end - self.start
        if scanned >= max { return Err(io._fail(io.ErrorKind.LimitExceeded)) }
        count := try await self._fill(stream)
        if count == 0 { return Ok(self._split(self.end)) }
    }
}
/// Owned write buffer. Pending bytes are `buffer[start..end]`. Writes are
/// copied in and reach the stream only when the buffer is full, a write is at
/// least as large as the buffer, or `flush` is called. Destruction discards
/// pending bytes without I/O: flushing is always explicit.
pub struct BufferedWriter {
    buffer Vec<u8>
    start usize
    end usize
}
/// A zero capacity aborts.
pub fn BufferedWriter.new(capacity usize) BufferedWriter {
    if capacity == 0 { panic("buffer capacity must be positive") }
    var buffer = Vec.new()
    _zero_fill(&mut buffer, capacity)
    return BufferedWriter{buffer: buffer, start: 0, end: 0}
}
pub fn BufferedWriter.pending(&self) usize { return self.end - self.start }
pub fn BufferedWriter.capacity(&self) usize { return self.buffer.len() }
/// Accepts at least one byte of a non-empty `data`. Flushes first only when
/// the buffer is full; an empty buffer and a large `data` write directly.
pub async fn BufferedWriter.write(&mut self, stream &mut TcpStream, data &[]u8) Result<usize, io.Error> {
    if data.len() == 0 { return Ok(0) }
    if self.end == self.buffer.len() { try await self.flush(stream) }
    if self.start == self.end && data.len() >= self.buffer.len() { return await stream.write_async(data) }
    end := self.end
    var count = self.buffer.len() - end
    if data.len() < count { count = data.len() }
    _copy_bytes(&mut self.buffer.as_mut_slice()[end..end + count], &data[0..count])
    self.end = end + count
    return Ok(count)
}
pub async fn BufferedWriter.write_all(&mut self, stream &mut TcpStream, data &[]u8) Result<void, io.Error> {
    var offset = usize(0)
    for {
        if offset == data.len() { return Ok(()) }
        count := try await self.write(stream, &data[offset..])
        if count == 0 { return Err(io._fail(io.ErrorKind.WriteZero)) }
        offset = offset + count
    }
}
/// Writes every pending byte. Partial writes continue where they stopped; on
/// an error exactly the unwritten bytes remain pending.
pub async fn BufferedWriter.flush(&mut self, stream &mut TcpStream) Result<void, io.Error> {
    for {
        if self.start == self.end {
            self.start = 0
            self.end = 0
            return Ok(())
        }
        start := self.start
        end := self.end
        count := try await stream.write_async(&self.buffer.as_slice()[start..end])
        if count == 0 { return Err(io._fail(io.ErrorKind.WriteZero)) }
        self.start = start + count
    }
}
