// Blocking and explicit nonblocking Linux networking. Opaque descriptors are owned, Transfer, not Share.
pub struct TcpListener { fd i32 }
pub struct TcpStream { fd i32 }
pub struct UdpSocket { fd i32 }
pub copy struct SocketAddr { data [24]u8 }
pub copy enum IpAddr {
    V4([4]u8)
    V6([16]u8)
}
pub copy enum Shutdown {
    Read
    Write
    Both
}
pub copy enum ErrorKind {
    AddressInUse
    ConnectionRefused
    ConnectionReset
    BrokenPipe
    TimedOut
    WouldBlock
    InvalidAddress
    DnsFailure
    OtherOs
    WriteZero
}
pub copy struct Error {
    pub kind ErrorKind
    code i32
    domain i32
}
pub copy struct RecvFrom {
    pub count usize
    pub peer SocketAddr
}
copy struct _Raw {
    domain i32
    code i32
    value i64
    address SocketAddr
}
extern "intrinsic" fn _resolve(address &string) _Raw
extern "intrinsic" fn _socket(address SocketAddr, udp bool) _Raw
extern "intrinsic" fn _bind(fd i32, address SocketAddr) _Raw
extern "intrinsic" fn _listen(fd i32) _Raw
extern "intrinsic" fn _accept(fd i32) _Raw
extern "intrinsic" fn _connect(fd i32, address SocketAddr) _Raw
extern "intrinsic" fn _read(fd i32, buffer &mut []u8) _Raw
extern "intrinsic" fn _write(fd i32, buffer &[]u8) _Raw
extern "intrinsic" fn _recv(fd i32, buffer &mut []u8) _Raw
extern "intrinsic" fn _send(fd i32, buffer &[]u8, address SocketAddr) _Raw
extern "intrinsic" fn _addr(fd i32, peer bool) _Raw
extern "intrinsic" fn _shutdown(fd i32, how i32) _Raw
extern "intrinsic" fn _close_listener(value TcpListener) _Raw
extern "intrinsic" fn _close_stream(value TcpStream) _Raw
extern "intrinsic" fn _close_udp(value UdpSocket) _Raw

fn _error(raw _Raw) Error {
    if raw.domain == 1 { return Error{kind: ErrorKind.DnsFailure, code: raw.code, domain: raw.domain} }
    if raw.domain == 2 { return Error{kind: ErrorKind.InvalidAddress, code: raw.code, domain: raw.domain} }
    var kind = ErrorKind.OtherOs
    if raw.code == 98 { kind = ErrorKind.AddressInUse }
    if raw.code == 111 { kind = ErrorKind.ConnectionRefused }
    if raw.code == 104 { kind = ErrorKind.ConnectionReset }
    if raw.code == 32 { kind = ErrorKind.BrokenPipe }
    if raw.code == 110 { kind = ErrorKind.TimedOut }
    if raw.code == 11 { kind = ErrorKind.WouldBlock }
    if raw.code == 22 || raw.code == 99 { kind = ErrorKind.InvalidAddress }
    return Error{kind: kind, code: raw.code, domain: raw.domain}
}
fn _check(raw _Raw) Result<_Raw, Error> {
    if raw.code != 0 || raw.domain != 0 { return Err(_error(raw)) }
    return Ok(raw)
}
pub fn Error.native_code(&self) i32 { return self.code }
pub fn Error.is_dns_code(&self) bool { return self.domain == 1 }
pub fn SocketAddr.port(&self) u16 { return u16(self.data[16]) * u16(256) + u16(self.data[17]) }
pub fn SocketAddr.is_ipv4(&self) bool { return self.data[18] == u8(4) }
pub fn SocketAddr.is_ipv6(&self) bool { return self.data[18] == u8(6) }
pub fn SocketAddr.with_port(self, port u16) SocketAddr {
    var result = self
    result.data[16] = u8(port / u16(256))
    result.data[17] = u8(port % u16(256))
    return result
}
pub fn SocketAddr.ip(&self) IpAddr {
    if self.is_ipv4() { return IpAddr.V4([4]u8{self.data[0], self.data[1], self.data[2], self.data[3]}) }
    return IpAddr.V6([16]u8{self.data[0], self.data[1], self.data[2], self.data[3], self.data[4], self.data[5], self.data[6], self.data[7], self.data[8], self.data[9], self.data[10], self.data[11], self.data[12], self.data[13], self.data[14], self.data[15]})
}
pub fn resolve(address &string) Result<SocketAddr, Error> {
    for {
        raw := _resolve(address)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try _check(raw)
        return Ok(checked.address)
    }
}
pub fn listen_tcp(address &string) Result<TcpListener, Error> { return TcpListener.bind(address) }
pub fn TcpListener.bind(address &string) Result<TcpListener, Error> { return TcpListener.bind_addr(try resolve(address)) }
pub fn TcpListener.bind_addr(address SocketAddr) Result<TcpListener, Error> {
    raw := try _open(address, false)
    listener := TcpListener{fd: i32(raw.value)}
    try _bound(listener.fd, address)
    try _listening(listener.fd)
    return Ok(listener)
}
pub fn TcpListener.accept(&mut self) Result<TcpStream, Error> {
    for {
        raw := _accept(self.fd)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(TcpStream{fd: i32(checked.value)})
    }
}
pub fn TcpStream.connect(address &string) Result<TcpStream, Error> { return TcpStream.connect_addr(try resolve(address)) }
pub fn TcpStream.connect_addr(address SocketAddr) Result<TcpStream, Error> {
    for {
        raw := try _open(address, false)
        stream := TcpStream{fd: i32(raw.value)}
        status := _connect(stream.fd, address)
        if status.code == 4 && status.domain == 0 { continue }
        try _check(status)
        return Ok(stream)
    }
}
pub fn TcpStream.write_all(&mut self, buffer &[]u8) Result<void, Error> {
    for {
        mode := _mode(self.fd)
        if mode.code == 4 && mode.domain == 0 { continue }
        checked := try _check(mode)
        if checked.value != 0 { return Err(Error{kind: ErrorKind.WouldBlock, code: 11, domain: 0}) }
        break
    }
    var offset = usize(0)
    for offset < buffer.len() {
        count := try self.write(&buffer[offset..])
        if count == usize(0) { return Err(Error{kind: ErrorKind.WriteZero, code: 0, domain: 0}) }
        offset = offset + count
    }
    return Ok(())
}
pub fn TcpStream.shutdown(&mut self, how Shutdown) Result<void, Error> {
    var direction = i32(2)
    match how {
        Shutdown.Read => { direction = i32(0) }
        Shutdown.Write => { direction = i32(1) }
        Shutdown.Both => {}
    }
    for {
        raw := _shutdown(self.fd, direction)
        if raw.code == 4 && raw.domain == 0 { continue }
        try _check(raw)
        return Ok(())
    }
}
pub fn UdpSocket.bind(address &string) Result<UdpSocket, Error> { return UdpSocket.bind_addr(try resolve(address)) }
pub fn UdpSocket.bind_addr(address SocketAddr) Result<UdpSocket, Error> {
    raw := try _open(address, true)
    socket := UdpSocket{fd: i32(raw.value)}
    try _bound(socket.fd, address)
    return Ok(socket)
}
pub fn UdpSocket.recv_from(&mut self, buffer &mut []u8) Result<RecvFrom, Error> {
    for {
        raw := _recv(self.fd, buffer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(RecvFrom{count: usize(checked.value), peer: checked.address})
    }
}
pub fn UdpSocket.send_to(&mut self, buffer &[]u8, peer SocketAddr) Result<usize, Error> {
    for {
        raw := _send(self.fd, buffer, peer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(usize(checked.value))
    }
}
pub fn TcpListener.local_addr(&self) Result<SocketAddr, Error> {
    for {
        raw := _addr(self.fd, false)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(checked.address)
    }
}
pub fn TcpListener.close(self) Result<void, Error> {
    try _check(_close_listener(self))
    return Ok(())
}
pub fn TcpStream.local_addr(&self) Result<SocketAddr, Error> {
    for {
        raw := _addr(self.fd, false)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(checked.address)
    }
}
pub fn TcpStream.peer_addr(&self) Result<SocketAddr, Error> {
    for {
        raw := _addr(self.fd, true)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(checked.address)
    }
}
pub fn TcpStream.close(self) Result<void, Error> {
    try _check(_close_stream(self))
    return Ok(())
}
pub fn UdpSocket.local_addr(&self) Result<SocketAddr, Error> {
    for {
        raw := _addr(self.fd, false)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(checked.address)
    }
}
pub fn UdpSocket.close(self) Result<void, Error> {
    try _check(_close_udp(self))
    return Ok(())
}
pub fn TcpStream.read(&mut self, buffer &mut []u8) Result<usize, Error> {
    for {
        raw := _read(self.fd, buffer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(usize(checked.value))
    }
}
pub fn TcpStream.write(&mut self, buffer &[]u8) Result<usize, Error> {
    for {
        raw := _write(self.fd, buffer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try _check(raw)
        return Ok(usize(checked.value))
    }
}

fn _open(address SocketAddr, udp bool) Result<_Raw, Error> {
    for {
        raw := _socket(address, udp)
        if raw.code == 4 && raw.domain == 0 { continue }
        return _check(raw)
    }
}

fn _bound(fd i32, address SocketAddr) Result<void, Error> {
    for {
        raw := _bind(fd, address)
        if raw.code == 4 && raw.domain == 0 { continue }
        try _check(raw)
        return Ok(())
    }
}
fn _listening(fd i32) Result<void, Error> {
    for {
        raw := _listen(fd)
        if raw.code == 4 && raw.domain == 0 { continue }
        try _check(raw)
        return Ok(())
    }
}

// Level-triggered readiness. Tokens are observations, never socket authority.
pub struct Poll { handle usize }
pub copy struct Token { value u64 }
pub copy enum Interest {
    Readable
    Writable
    ReadableWritable
}
pub copy struct Event {
    pub token Token
    pub readable bool
    pub writable bool
    pub error bool
    pub hangup bool
}
pub struct Connecting {
    stream TcpStream
    status i32
}
extern "intrinsic" fn _nonblocking(fd i32, enabled bool) _Raw
extern "intrinsic" fn _mode(fd i32) _Raw
extern "intrinsic" fn _connected(fd i32) _Raw
extern "intrinsic" fn _now() _Raw
extern "intrinsic" fn _poll_new() _Raw
extern "intrinsic" fn _poll_ctl(handle usize, fd i32, operation i32, interest i32, token u64) _Raw
extern "intrinsic" fn _poll_wait(handle usize, events &mut []Event, timeout i32) _Raw
extern "intrinsic" fn _close_poll(value Poll) _Raw

pub fn Event.empty() Event {
    return Event{token: Token{value: u64(0)}, readable: false, writable: false, error: false, hangup: false}
}
pub fn Token.same(self, other Token) bool { return self.value == other.value }
fn _set_nonblocking(fd i32, enabled bool) Result<void, Error> {
    for {
        raw := _nonblocking(fd, enabled)
        if raw.code == 4 && raw.domain == 0 { continue }
        try _check(raw)
        return Ok(())
    }
}
pub fn TcpListener.set_nonblocking(&mut self, enabled bool) Result<void, Error> { return _set_nonblocking(self.fd, enabled) }
pub fn TcpStream.set_nonblocking(&mut self, enabled bool) Result<void, Error> { return _set_nonblocking(self.fd, enabled) }
pub fn UdpSocket.set_nonblocking(&mut self, enabled bool) Result<void, Error> { return _set_nonblocking(self.fd, enabled) }
pub fn TcpStream.connect_nonblocking(address &string) Result<Connecting, Error> { return TcpStream.connect_nonblocking_addr(try resolve(address)) }
pub fn TcpStream.connect_nonblocking_addr(address SocketAddr) Result<Connecting, Error> {
    raw := try _open(address, false)
    var stream = TcpStream{fd: i32(raw.value)}
    try stream.set_nonblocking(true)
    status := _connect(stream.fd, address)
    if status.domain == 0 && (status.code == 115 || status.code == 4) {
        return Ok(Connecting{stream: stream, status: 115})
    }
    try _check(status)
    return Ok(Connecting{stream: stream, status: 0})
}
pub fn Connecting.poll_connected(&mut self) Result<bool, Error> {
    if self.status == 0 { return Ok(true) }
    if self.status != 115 { return Err(_connection_error(self.status)) }
    for {
        raw := _connected(self.stream.fd)
        if raw.domain == 0 && raw.code == 4 { continue }
        if raw.domain == 0 && raw.code == 11 { return Ok(false) }
        self.status = raw.code
        try _check(raw)
        return Ok(true)
    }
}
pub fn Connecting.into_stream(self) Result<TcpStream, Error> {
    if self.status != 0 { return Err(_connection_error(self.status)) }
    return Ok(self.stream)
}
pub fn Poll.new() Result<Poll, Error> {
    for {
        raw := _poll_new()
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try _check(raw)
        return Ok(Poll{handle: usize(checked.value)})
    }
}
fn _interest(value Interest) i32 {
    match value {
        Interest.Readable => { return 1 }
        Interest.Writable => { return 2 }
        Interest.ReadableWritable => { return 3 }
    }
}
fn _registration(handle usize, fd i32, op i32, interest Interest, token Token) Result<Token, Error> {
    for {
        raw := _poll_ctl(handle, fd, op, _interest(interest), token.value)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try _check(raw)
        return Ok(Token{value: u64(checked.value)})
    }
}
pub fn Poll.register_listener(&mut self, socket &TcpListener, interest Interest) Result<Token, Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: u64(0)}) }
pub fn Poll.register_stream(&mut self, socket &TcpStream, interest Interest) Result<Token, Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: u64(0)}) }
pub fn Poll.register_udp(&mut self, socket &UdpSocket, interest Interest) Result<Token, Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: u64(0)}) }
pub fn Poll.register_connecting(&mut self, socket &Connecting) Result<Token, Error> { return _registration(self.handle, socket.stream.fd, 0, Interest.Writable, Token{value: u64(0)}) }
pub fn Poll.modify_listener(&mut self, socket &TcpListener, token Token, interest Interest) Result<void, Error> {
    try _registration(self.handle, socket.fd, 1, interest, token)
    return Ok(())
}
pub fn Poll.modify_stream(&mut self, socket &TcpStream, token Token, interest Interest) Result<void, Error> {
    try _registration(self.handle, socket.fd, 1, interest, token)
    return Ok(())
}
pub fn Poll.modify_udp(&mut self, socket &UdpSocket, token Token, interest Interest) Result<void, Error> {
    try _registration(self.handle, socket.fd, 1, interest, token)
    return Ok(())
}
pub fn Poll.deregister_listener(&mut self, socket &TcpListener, token Token) Result<void, Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.deregister_stream(&mut self, socket &TcpStream, token Token) Result<void, Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.deregister_udp(&mut self, socket &UdpSocket, token Token) Result<void, Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.deregister_connecting(&mut self, socket &Connecting, token Token) Result<void, Error> {
    try _registration(self.handle, socket.stream.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.wait(&mut self, events &mut []Event, timeout i32) Result<usize, Error> {
    if timeout < -1 || events.len() == usize(0) { return Err(Error{kind: ErrorKind.InvalidAddress, code: 22, domain: 0}) }
    var remaining = timeout
    var deadline = i64(0)
    if timeout > 0 { deadline = (try _check(_now())).value + i64(timeout) }
    for {
        raw := _poll_wait(self.handle, events, remaining)
        if raw.domain == 0 && raw.code == 4 {
            if timeout > 0 {
                now := (try _check(_now())).value
                if now >= deadline { return Ok(usize(0)) }
                remaining = i32(deadline - now)
            }
            continue
        }
        checked := try _check(raw)
        return Ok(usize(checked.value))
    }
}
pub fn Poll.close(self) Result<void, Error> {
    try _check(_close_poll(self))
    return Ok(())
}

fn _connection_error(code i32) Error {
    var kind = ErrorKind.OtherOs
    if code == 115 { kind = ErrorKind.WouldBlock }
    if code == 111 { kind = ErrorKind.ConnectionRefused }
    if code == 104 { kind = ErrorKind.ConnectionReset }
    if code == 110 { kind = ErrorKind.TimedOut }
    return Error{kind: kind, code: code, domain: 0}
}

// Phase 12C manual/internal execution surface; not stable async syntax.
struct _ExecutionState { native usize }
pub struct Execution {
    state _ExecutionState
    poll Poll
}
pub struct Waker { native usize }
pub enum Progress<R> {
    Pending
    Ready(R)
}
pub struct Operation<R> {
    poller mut fn(&Waker) Progress<R>
    waker Waker
    complete bool
}
pub struct Executor { tasks [16]Option<Operation<void>> }
extern "intrinsic" fn _exec_new(poll usize) _Raw
extern "intrinsic" fn _waker_new(owner &Execution) Waker
extern "intrinsic" fn _wake(waker &Waker) _Raw
extern "intrinsic" fn _wake_link(child &Waker, parent &Waker) _Raw
extern "intrinsic" fn _wake_owner(waker &Waker, owner usize) _Raw
extern "intrinsic" fn _wake_take(waker &Waker) _Raw
extern "intrinsic" fn _wake_arm(waker &Waker, fd i32, interest i32) _Raw
extern "intrinsic" fn _wake_clear(waker &Waker) _Raw
extern "intrinsic" fn _exec_wait(owner usize, timeout i32) _Raw

pub fn Execution.new() Result<Execution, Error> {
    poll := try Poll.new()
    raw := try _check(_exec_new(poll.handle))
    return Ok(Execution{state: _ExecutionState{native: usize(raw.value)}, poll: poll})
}
pub fn Operation<R>.new(owner &Execution, poller mut fn(&Waker) Progress<R>) Operation<R> {
    return Operation{poller: poller, waker: _waker_new(owner), complete: false}
}
pub fn Operation<R>.wake(&self) { _wake(&self.waker) }
pub fn Operation<R>.runnable(&self) bool { return _wake_take(&self.waker).value != 0 }
pub fn Operation<R>.poll(&mut self) Progress<R> {
    if self.complete { panic("operation polled after completion") }
    result := self.poller(&self.waker)
    match &result {
        Progress.Pending => {}
        Progress.Ready(value) => {
            self.complete = true
            _wake_clear(&self.waker)
        }
    }
    return result
}
// Consume the operation to release its conservative across-suspension loans.
pub fn Operation<R>.finish(self) {}
pub fn Executor.new() Executor {
    return Executor{tasks: [16]Option<Operation<void>>{None, None, None, None, None, None, None, None, None, None, None, None, None, None, None, None}}
}
// Consuming insertion returns the new loan holder through ordinary provenance.
pub fn Executor.add(self, operation Operation<void>) Executor {
    var executor = self
    for i in 0..16 {
        match &executor.tasks[i] {
            None => { executor.tasks[i] = Some(operation)
                return executor
            }
            Some(value) => {}
        }
    }
    panic("manual executor capacity exceeded")
}
pub fn Executor.turn(&mut self, owner &Execution, timeout i32) Result<usize, Error> {
    // Readiness is serviced even when a task self-wakes continuously.
    try owner.wait(0)
    var remaining = usize(0)
    var polled = false
    for i in 0..16 {
        var complete = false
        match &mut self.tasks[i] {
            None => {}
            Some(operation) => {
                try _check(_wake_owner(&operation.waker, owner.state.native))
                remaining = remaining + usize(1)
                if operation.runnable() {
                    polled = true
                    match operation.poll() {
                        Progress.Pending => {}
                        Progress.Ready(value) => { complete = true }
                    }
                }
            }
        }
        if complete { self.tasks[i] = None
            remaining = remaining - usize(1)
        }
    }
    if !polled && remaining != usize(0) { try owner.wait(timeout) }
    return Ok(remaining)
}
pub fn Executor.run(self, owner &Execution) Result<void, Error> {
    var executor = self
    for {
        if try executor.turn(owner, -1) == usize(0) { return Ok(()) }
    }
}

fn _require_nonblocking(fd i32) Result<void, Error> {
    for {
        raw := _mode(fd)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try _check(raw)
        if checked.value == 0 { return Err(Error{kind: ErrorKind.InvalidAddress, code: 22, domain: 0}) }
        return Ok(())
    }
}
fn _arm(waker &Waker, fd i32, interest i32) Result<void, Error> {
    for {
        raw := _wake_arm(waker, fd, interest)
        if raw.domain == 0 && raw.code == 4 { continue }
        try _check(raw)
        return Ok(())
    }
}
fn _would_block(error Error) bool {
    match error.kind { ErrorKind.WouldBlock => { return true }
        _ => { return false } }
}
pub fn poll_read(waker &Waker, stream &mut TcpStream, buffer &mut []u8) Progress<Result<usize, Error>> {
    match _require_nonblocking(stream.fd) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.read(buffer) {
        Ok(count) => { return Progress.Ready(Ok(count)) }
        Err(error) => { if !_would_block(error) { return Progress.Ready(Err(error)) } }
    }
    match _arm(waker, stream.fd, 1) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.read(buffer) {
        Ok(count) => { return Progress.Ready(Ok(count)) }
        Err(error) => { if !_would_block(error) { return Progress.Ready(Err(error)) } }
    }
    return Progress.Pending
}
pub fn read_operation(owner &Execution, stream &mut TcpStream, buffer &mut []u8) Operation<Result<usize, Error>> {
    return Operation.new(owner, move fn(waker &Waker) Progress<Result<usize, Error>> { return _leaf(waker, poll_read(waker, stream, buffer)) })
}
pub fn poll_write(waker &Waker, stream &mut TcpStream, buffer &[]u8) Progress<Result<usize, Error>> {
    match _require_nonblocking(stream.fd) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.write(buffer) {
        Ok(count) => { return Progress.Ready(Ok(count)) }
        Err(error) => { if !_would_block(error) { return Progress.Ready(Err(error)) } }
    }
    match _arm(waker, stream.fd, 2) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.write(buffer) {
        Ok(count) => { return Progress.Ready(Ok(count)) }
        Err(error) => { if !_would_block(error) { return Progress.Ready(Err(error)) } }
    }
    return Progress.Pending
}
pub fn write_operation(owner &Execution, stream &mut TcpStream, buffer &[]u8) Operation<Result<usize, Error>> {
    return Operation.new(owner, move fn(waker &Waker) Progress<Result<usize, Error>> { return _leaf(waker, poll_write(waker, stream, buffer)) })
}
pub fn write_all_operation(owner &Execution, stream &mut TcpStream, buffer &[]u8) Operation<Result<void, Error>> {
    var offset = usize(0)
    return Operation.new(owner, move fn(waker &Waker) Progress<Result<void, Error>> {
        match _require_nonblocking(stream.fd) { Err(error) => { return Progress.Ready(Err(error)) }
            Ok(value) => {} }
        if offset == buffer.len() { return Progress.Ready(Ok(())) }
        match poll_write(waker, stream, &buffer[offset..]) {
            Progress.Pending => { return Progress.Pending }
            Progress.Ready(result) => match result {
                Err(error) => { return Progress.Ready(Err(error)) }
                Ok(count) => {
                    if count == usize(0) { return Progress.Ready(Err(Error{kind: ErrorKind.WriteZero, code: 0, domain: 0})) }
                    offset = offset + count
                    if offset == buffer.len() { return Progress.Ready(Ok(())) }
                    _wake(waker)
                    return Progress.Pending
                }
            }
        }
    })
}
pub fn poll_accept(waker &Waker, listener &mut TcpListener) Progress<Result<TcpStream, Error>> {
    match _require_nonblocking(listener.fd) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match listener.accept() {
        Ok(stream) => { return Progress.Ready(Ok(stream)) }
        Err(error) => { if !_would_block(error) { return Progress.Ready(Err(error)) } }
    }
    match _arm(waker, listener.fd, 1) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match listener.accept() {
        Ok(stream) => { return Progress.Ready(Ok(stream)) }
        Err(error) => { if !_would_block(error) { return Progress.Ready(Err(error)) } }
    }
    return Progress.Pending
}
pub fn accept_operation(owner &Execution, listener &mut TcpListener) Operation<Result<TcpStream, Error>> {
    return Operation.new(owner, move fn(waker &Waker) Progress<Result<TcpStream, Error>> { return _leaf(waker, poll_accept(waker, listener)) })
}
pub fn poll_connect(waker &Waker, connecting &mut Connecting) Progress<Result<void, Error>> {
    match connecting.poll_connected() {
        Ok(complete) => { if complete { return Progress.Ready(Ok(())) } }
        Err(error) => { return Progress.Ready(Err(error)) }
    }
    match _arm(waker, connecting.stream.fd, 2) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match connecting.poll_connected() {
        Ok(complete) => { if complete { return Progress.Ready(Ok(())) } }
        Err(error) => { return Progress.Ready(Err(error)) }
    }
    return Progress.Pending
}
pub fn connect_operation(owner &Execution, connecting &mut Connecting) Operation<Result<void, Error>> {
    return Operation.new(owner, move fn(waker &Waker) Progress<Result<void, Error>> { return _leaf(waker, poll_connect(waker, connecting)) })
}
pub fn poll_recv(waker &Waker, socket &mut UdpSocket, buffer &mut []u8) Progress<Result<RecvFrom, Error>> {
    match _require_nonblocking(socket.fd) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match socket.recv_from(buffer) {
        Ok(packet) => { return Progress.Ready(Ok(packet)) }
        Err(error) => { if !_would_block(error) { return Progress.Ready(Err(error)) } }
    }
    match _arm(waker, socket.fd, 1) { Err(error) => { return Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match socket.recv_from(buffer) {
        Ok(packet) => { return Progress.Ready(Ok(packet)) }
        Err(error) => { if !_would_block(error) { return Progress.Ready(Err(error)) } }
    }
    return Progress.Pending
}
pub fn recv_operation(owner &Execution, socket &mut UdpSocket, buffer &mut []u8) Operation<Result<RecvFrom, Error>> {
    return Operation.new(owner, move fn(waker &Waker) Progress<Result<RecvFrom, Error>> { return _leaf(waker, poll_recv(waker, socket, buffer)) })
}
pub fn Execution.wait(&self, timeout i32) Result<void, Error> {
    if timeout < -1 { return Err(Error{kind: ErrorKind.InvalidAddress, code: 22, domain: 0}) }
    var remaining = timeout
    var deadline = i64(0)
    if timeout > 0 { deadline = (try _check(_now())).value + i64(timeout) }
    for {
        raw := _exec_wait(self.state.native, remaining)
        if raw.domain == 0 && raw.code == 4 {
            if timeout > 0 {
                now := (try _check(_now())).value
                if now >= deadline { return Ok(()) }
                remaining = i32(deadline - now)
            }
            continue
        }
        try _check(raw)
        return Ok(())
    }
}
pub fn Waker.wake(&self) { _wake(self) }

pub fn Operation<R>.poll_with(&mut self, parent &Waker) Progress<R> {
    if _wake_link(&self.waker, parent).code != 0 { panic("invalid nested wake association") }
    _wake_take(&self.waker)
    return self.poll()
}

// Drive one top-level operation on the current thread until Ready (ADR 0037).
// The caller owns the Operation (an async computation is accepted as its
// poller by Operation.new); its result may borrow what the poller borrowed,
// and the Operation is destroyed exactly once by the caller's scope.
pub fn Execution.block_on<R>(&self, operation &mut Operation<R>) Result<R, Error> {
    try _check(_wake_owner(&operation.waker, self.state.native))
    operation.wake()
    for {
        if operation.runnable() {
            match operation.poll() {
                Progress.Pending => {}
                Progress.Ready(value) => { return Ok(value) }
            }
        } else {
            try self.wait(-1)
        }
    }
}

// Async-body primitives (ADR 0037), private to this trusted module. Lowering
// calls `body` with the current poll's Waker, and turns `_async_park` into a
// bare suspension edge. The Waker loan cannot outlive the callback.
extern "intrinsic" fn _with_waker<R>(body mut fn(&Waker) R) R
extern "intrinsic" fn _async_park()

// A completed async leaf releases its readiness registration, as a completed
// Operation does. Source computations share one Waker sequentially, so the next
// leaf may arm another descriptor. A wake already queued is preserved.
fn _disarm(waker &Waker) {
    queued := _wake_take(waker).value != 0
    _wake_clear(waker)
    if queued { _wake(waker) }
}
fn _leaf<R>(waker &Waker, progress Progress<R>) Progress<R> {
    match &progress {
        Progress.Ready(value) => { _disarm(waker) }
        Progress.Pending => {}
    }
    return progress
}

// Explicit async I/O over the Phase-12C poll functions. Blocking methods keep
// their names and behavior; these never block the executor. They require
// nonblocking sockets, exactly like the manual operations.
pub async fn TcpStream.read_async(&mut self, buffer &mut []u8) Result<usize, Error> {
    for {
        match _with_waker(fn(waker &Waker) Progress<Result<usize, Error>> { return _leaf(waker, poll_read(waker, self, buffer)) }) {
            Progress.Ready(result) => { return result }
            Progress.Pending => {}
        }
        _async_park()
    }
}
pub async fn TcpStream.write_async(&mut self, buffer &[]u8) Result<usize, Error> {
    for {
        match _with_waker(fn(waker &Waker) Progress<Result<usize, Error>> { return _leaf(waker, poll_write(waker, self, buffer)) }) {
            Progress.Ready(result) => { return result }
            Progress.Pending => {}
        }
        _async_park()
    }
}
// At most one successful write per poll; partial progress wakes the same
// Waker before parking, so the next executor turn continues (fairness).
pub async fn TcpStream.write_all_async(&mut self, buffer &[]u8) Result<void, Error> {
    var offset = usize(0)
    for {
        if offset == buffer.len() { return Ok(()) }
        match _with_waker(fn(waker &Waker) Progress<Result<usize, Error>> {
            match _leaf(waker, poll_write(waker, self, &buffer[offset..])) {
                Progress.Ready(result) => match result {
                    Ok(count) => {
                        if count != usize(0) && offset + count != buffer.len() { _wake(waker) }
                        return Progress.Ready(Ok(count))
                    }
                    Err(error) => { return Progress.Ready(Err(error)) }
                }
                Progress.Pending => { return Progress.Pending }
            }
        }) {
            Progress.Ready(result) => {
                count := try result
                if count == usize(0) { return Err(Error{kind: ErrorKind.WriteZero, code: 0, domain: 0}) }
                offset = offset + count
            }
            Progress.Pending => {}
        }
        if offset != buffer.len() { _async_park() }
    }
}
pub async fn TcpListener.accept_async(&mut self) Result<TcpStream, Error> {
    for {
        match _with_waker(fn(waker &Waker) Progress<Result<TcpStream, Error>> { return _leaf(waker, poll_accept(waker, self)) }) {
            Progress.Ready(result) => { return result }
            Progress.Pending => {}
        }
        _async_park()
    }
}
pub async fn Connecting.finish_async(&mut self) Result<void, Error> {
    for {
        match _with_waker(fn(waker &Waker) Progress<Result<void, Error>> { return _leaf(waker, poll_connect(waker, self)) }) {
            Progress.Ready(result) => { return result }
            Progress.Pending => {}
        }
        _async_park()
    }
}
pub async fn UdpSocket.recv_from_async(&mut self, buffer &mut []u8) Result<RecvFrom, Error> {
    for {
        match _with_waker(fn(waker &Waker) Progress<Result<RecvFrom, Error>> { return _leaf(waker, poll_recv(waker, self, buffer)) }) {
            Progress.Ready(result) => { return result }
            Progress.Pending => {}
        }
        _async_park()
    }
}
