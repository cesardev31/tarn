pub extern "intrinsic" fn AtomicUsize.load(&self) usize
pub extern "intrinsic" fn AtomicUsize.store(&self, value usize)
pub extern "intrinsic" fn AtomicUsize.swap(&self, value usize) usize
/// Strong comparison: true exactly when expected matched and replacement occurred.
