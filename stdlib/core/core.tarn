pub extern "intrinsic" fn AtomicUsize.fetch_sub(&self, value usize) usize

// ------------------------------------------------ UTF-8 bridges (phase 15A)
/// Immutable UTF-8 bytes; the slice borrows this string.
pub extern "intrinsic" fn string.bytes(&self) &[]u8
/// Validate UTF-8 and copy the bytes into a new owner; invalid input is None.
pub extern "intrinsic" fn string_from_utf8(data &[]u8) Option<string>
