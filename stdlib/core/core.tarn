/// All operations are sequentially consistent. No ordinary scalar projection.
pub struct AtomicI64 { native usize }
pub extern "intrinsic" fn AtomicI64.new(value i64) AtomicI64
pub extern "intrinsic" fn AtomicI64.load(&self) i64
pub extern "intrinsic" fn AtomicI64.store(&self, value i64)
pub extern "intrinsic" fn AtomicI64.swap(&self, value i64) i64
/// Strong comparison: true exactly when expected matched and replacement occurred.
pub extern "intrinsic" fn AtomicI64.compare_exchange(&self, expected i64, value i64) bool
/// Return the old value. Overflow aborts before modification.
pub extern "intrinsic" fn AtomicI64.fetch_add(&self, value i64) i64
pub extern "intrinsic" fn AtomicI64.fetch_sub(&self, value i64) i64

