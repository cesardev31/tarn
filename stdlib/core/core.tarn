pub extern "intrinsic" fn AtomicU64.load(&self) u64
pub extern "intrinsic" fn AtomicU64.store(&self, value u64)
pub extern "intrinsic" fn AtomicU64.swap(&self, value u64) u64
/// Strong comparison: true exactly when expected matched and replacement occurred.
pub extern "intrinsic" fn AtomicU64.compare_exchange(&self, expected u64, value u64) bool
