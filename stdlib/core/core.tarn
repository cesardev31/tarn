pub extern "intrinsic" fn AtomicU32.load(&self) u32
pub extern "intrinsic" fn AtomicU32.store(&self, value u32)
pub extern "intrinsic" fn AtomicU32.swap(&self, value u32) u32
/// Strong comparison: true exactly when expected matched and replacement occurred.
pub extern "intrinsic" fn AtomicU32.compare_exchange(&self, expected u32, value u32) bool
/// Return the old value. Overflow aborts before modification.
pub extern "intrinsic" fn AtomicU32.fetch_add(&self, value u32) u32
pub extern "intrinsic" fn AtomicU32.fetch_sub(&self, value u32) u32

