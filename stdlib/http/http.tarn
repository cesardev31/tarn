            LimitKind.Headers => { return u16(431) }
            LimitKind.Trailers => { return u16(431) }
            LimitKind.Body => { return u16(413) }
            LimitKind.ChunkMetadata => { return u16(413) }
            LimitKind.Response => { return u16(500) }
