// Bounded server-side HTTP/1.1. Ordinary Tarn; no native HTTP privileges.
import "io"
import "net"
import "time"
import "runtime"
import "string"

pub copy enum Stage {
    Head
    Body
    Write
}
pub copy enum ProtocolError {
    Syntax
    Version
    Host
    Framing
    Chunk
    Trailer
    Expect
    Unsupported
    Incomplete
}
pub copy enum LimitKind {
    RequestLine
    Headers
    Body
    ChunkMetadata
    Trailers
    Response
}
pub copy enum Error {
    Io(io.Error)
    Protocol(ProtocolError)
    Limit(LimitKind)
    Timeout(Stage)
    InvalidConfig
    InvalidResponse
    InvalidText
    InvalidState
}
pub fn Error.status(self) u16 {
    match self {
        Error.Protocol(problem) => match problem {
            ProtocolError.Version => { return 505 }
            ProtocolError.Expect => { return 417 }
            ProtocolError.Unsupported => { return 501 }
            _ => { return 400 }
        }
        Error.Limit(kind) => match kind {
            LimitKind.RequestLine => { return 414 }
            LimitKind.Headers => { return 431 }
            LimitKind.Trailers => { return 431 }
            LimitKind.Body => { return 413 }
            LimitKind.ChunkMetadata => { return 413 }
            LimitKind.Response => { return 500 }
        }
        Error.Timeout(stage) => { return 408 }
        _ => { return 500 }
    }
}
pub copy struct Limits {
    pub request_line usize
    pub line usize
    pub head usize
    pub headers usize
    pub body usize
    pub response_body usize
    pub response_head usize
    pub response_headers usize
    pub chunk_metadata usize
    pub chunks usize
    pub trailers usize
    pub buffer usize
    pub requests usize
}
pub fn Limits.defaults() Limits {
    return Limits{request_line: 8192, line: 8192, head: 32768, headers: 100, body: 1048576, response_body: 1048576, response_head: 32768, response_headers: 100, chunk_metadata: 65536, chunks: 4096, trailers: 20, buffer: 8192, requests: 100}
}
pub copy struct Timeouts {
    pub head time.Duration
    pub body time.Duration
    pub write time.Duration
}
pub fn Timeouts.defaults() Timeouts {
    return Timeouts{head: time.Duration.seconds(10), body: time.Duration.seconds(30), write: time.Duration.seconds(10)}
}
fn _duration_valid(value time.Duration) bool { return value.as_millis() > 0 && value.as_millis() <= 4294967295 }
fn _config_valid(l Limits, t Timeouts) bool {
    // Bounds avoid reserve doubling and arithmetic overflow; not allocation promises.
    return l.request_line >= 2 && l.line >= 2 && l.head >= l.request_line && l.headers > 0 && l.body > 0 && l.response_body > 0 && l.response_head >= 64 && l.response_headers > 0 && l.chunk_metadata >= l.line && l.chunks > 0 && l.trailers > 0 && l.buffer > 0 && l.requests > 0 && l.head <= 1073741824 && l.line <= l.head && l.body <= 1073741824 && l.response_body <= 1073741824 && l.response_head <= 1073741824 && l.chunk_metadata <= 1073741824 && l.buffer <= 1073741824 && _duration_valid(t.head) && _duration_valid(t.body) && _duration_valid(t.write)
}
fn _copy(data &[]u8) Vec<u8> {
    var out: Vec<u8> = Vec.new()
    out.extend_from_slice(data)
    return out
}
fn _append(out &mut Vec<u8>, data &[]u8) { for b in data { out.push(b) } }
fn _text(data &[]u8) Result<string, Error> {
    match string.from_utf8(data) {
        Some(value) => { return Ok(value) }
        None => { return Err(Error.InvalidText) }
    }
}
fn _eq(a &[]u8, b &[]u8) bool {
    if a.len() != b.len() { return false }
    for i in 0..a.len() { if a[i] != b[i] { return false } }
    return true
}
fn _lower(b u8) u8 {
    if b >= 65 && b <= 90 { return b + 32 }
    return b
}
fn _ieq(a &[]u8, b &[]u8) bool {
    if a.len() != b.len() { return false }
    for i in 0..a.len() { if _lower(a[i]) != _lower(b[i]) { return false } }
    return true
}
fn _token(b u8) bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126
}
fn _tokens(data &[]u8) bool {
    if data.len() == 0 { return false }
    for b in data { if !_token(b) { return false } }
    return true
}
fn _trim(data &[]u8) &[]u8 {
    var first = usize(0)
    var last = data.len()
    for first < last && (data[first] == 32 || data[first] == 9) { first = first + 1 }
    for last > first && (data[last - 1] == 32 || data[last - 1] == 9) { last = last - 1 }
    return &data[first..last]
}
fn _find(data &[]u8, byte u8) usize {
    for i in 0..data.len() { if data[i] == byte { return i } }
    return data.len()
}
fn _hex(b u8) usize {
    if b >= 48 && b <= 57 { return usize(b - 48) }
    c := _lower(b)
    if c >= 97 && c <= 102 { return usize(c - 97) + 10 }
    return 16
}
fn _decimal(data &[]u8, max usize) Option<usize> {
    if data.len() == 0 { return None }
    var n = usize(0)
    for b in data {
        if b < 48 || b > 57 { return None }
        d := usize(b - 48)
        if d > max || n > (max - d) / 10 { return None }
        n = n * 10 + d
    }
    return Some(n)
}
pub struct Header {
    _name string
    _value Vec<u8>
}
pub fn Header.new(name &string, value &[]u8) Result<Header, Error> {
    if !_tokens(name.bytes()) { return Err(Error.InvalidResponse) }
    var lower = Vec.new()
    for b in name.bytes() { lower.push(_lower(b)) }
    for b in value { if (b < 32 && b != 9) || b == 127 { return Err(Error.InvalidResponse) } }
    return Ok(Header{_name: try _text(lower.as_slice()), _value: _copy(_trim(value))})
}
pub fn Header.text(name &string, value &string) Result<Header, Error> { return Header.new(name, value.bytes()) }
pub fn Header.name(&self) &string { return &self._name }
pub fn Header.value(&self) &[]u8 { return self._value.as_slice() }
pub fn Header.value_text(&self) Result<string, Error> { return _text(self._value.as_slice()) }
pub fn Header.clone(&self) Header { return Header{_name: self._name.clone(), _value: _copy(self._value.as_slice())} }
pub struct Request {
    _method string
    _target string
    _headers Vec<Header>
    _body Vec<u8>
    _trailers Vec<Header>
}
pub fn Request.method(&self) &string { return &self._method }
pub fn Request.target(&self) &string { return &self._target }
pub fn Request.headers(&self) &[]Header { return self._headers.as_slice() }
pub fn Request.trailers(&self) &[]Header { return self._trailers.as_slice() }
pub fn Request.body(&self) &[]u8 { return self._body.as_slice() }
pub fn Request.into_body(self) Vec<u8> { return self._body }
pub fn Request.header(&self, name &string) Option<Header> {
    for h in self._headers.as_slice() { if _ieq(h._name.bytes(), name.bytes()) { return Some(h.clone()) } }
    return None
}
pub struct Response {
    _status u16
    _headers Vec<Header>
    _body Vec<u8>
    close bool
}
pub fn Response.bytes(status u16, body Vec<u8>) Result<Response, Error> {
    if status < 200 || status > 599 { return Err(Error.InvalidResponse) }
    return Ok(Response{_status: status, _headers: Vec.new(), _body: body, close: false})
}
pub fn Response.text(status u16, body &string) Result<Response, Error> {
    return (try Response.bytes(status, _copy(body.bytes()))).header(try Header.text("content-type", "text/plain; charset=utf-8"))
}
fn _reserved(name &[]u8) bool {
    return _eq(name, "content-length".bytes()) || _eq(name, "transfer-encoding".bytes()) || _eq(name, "connection".bytes()) || _eq(name, "trailer".bytes()) || _eq(name, "upgrade".bytes())
}
pub fn Response.header(self, header Header) Result<Response, Error> {
    if _reserved(header._name.bytes()) { return Err(Error.InvalidResponse) }
    var out = self
    out._headers.push(header)
    return Ok(out)
}
pub fn Response.close_connection(self) Response {
    var out = self
    out.close = true
    return out
}
pub fn Response.status(&self) u16 { return self._status }
/// Already-encoded JSON text (for example from json.encode) with
/// content-type application/json. http does not depend on the json module.
pub fn Response.json(status u16, body string) Result<Response, Error> {
    return (try Response.bytes(status, _copy(body.bytes()))).header(try Header.text("content-type", "application/json"))
}
/// No body, such as 204 or an error status without detail.
pub fn Response.empty(status u16) Result<Response, Error> { return Response.bytes(status, Vec.new()) }
/// 405 with the required Allow header, e.g. `"GET, POST"`.
pub fn Response.method_not_allowed(allow &string) Result<Response, Error> {
    return (try Response.empty(405)).header(try Header.text("allow", allow))
}

// Infallible shorthands for handlers whose statuses and headers are fixed in
// source (ADR 0052 follow-up). An invalid status or header here is a
// programming error, like an out-of-range index, and aborts. Use the
// `Response.*` constructors when the status comes from data.
fn _fixed(response Result<Response, Error>) Response {
    match response {
        Ok(value) => { return value }
        Err(error) => { panic("http: invalid fixed response (status must be 200-599, headers must be valid)") }
    }
}
/// JSON text with content-type application/json.
pub fn json(status u16, body string) Response { return _fixed(Response.json(status, body)) }
/// UTF-8 text with content-type text/plain.
pub fn text(status u16, body &string) Response { return _fixed(Response.text(status, body)) }
/// No body.
pub fn empty(status u16) Response { return _fixed(Response.empty(status)) }
/// 405 with Allow; `allow` is normally a literal such as `"GET, POST"`.
pub fn method_not_allowed(allow &string) Response { return _fixed(Response.method_not_allowed(allow)) }

// Strict authority validation never performs DNS. IPv6 compression is lexical.
fn _ipv4(data &[]u8) bool {
    var start = usize(0)
    var parts = usize(0)
    for i in 0..data.len() + 1 {
        if i == data.len() || data[i] == 46 {
            segment := &data[start..i]
            if segment.len() > 3 || (segment.len() > 1 && segment[0] == 48) { return false }
            match _decimal(segment, 255) { Some(n) => {}
                None => { return false } }
            parts = parts + 1
            start = i + 1
        }
    }
    return parts == 4
}
fn _ipv6(data &[]u8) bool {
    if data.len() < 2 { return false }
    var i = usize(0)
    var groups = usize(0)
    var compressed = false
    if data[0] == 58 {
        if data[1] != 58 { return false }
        compressed = true
        i = 2
    }
    for i < data.len() {
        start := i
        for i < data.len() && data[i] != 58 { i = i + 1 }
        part := &data[start..i]
        if _find(part, 46) < part.len() {
            if i != data.len() || !_ipv4(part) { return false }
            groups = groups + 2
        } else {
            if part.len() == 0 || part.len() > 4 { return false }
            for b in part { if _hex(b) == 16 { return false } }
            groups = groups + 1
        }
        if groups > 8 { return false }
        if i < data.len() {
            i = i + 1
            if i == data.len() { return false }
            if data[i] == 58 {
                if compressed { return false }
                compressed = true
                i = i + 1
            }
        }
    }
    if compressed { return groups < 8 }
    return groups == 8
}
fn _host(data &[]u8) bool {
    if data.len() == 0 { return false }
    var end = data.len()
    var port = end
    if data[0] == 91 {
        end = _find(data, 93)
        if end == data.len() || !_ipv6(&data[1..end]) { return false }
        if end + 1 < data.len() {
            if data[end + 1] != 58 { return false }
            port = end + 2
        }
    } else {
        end = _find(data, 58)
        if end < data.len() { port = end + 1 }
        if end == 0 { return false }
        host := &data[..end]
        var numeric = true
        for b in host { if !(b >= 48 && b <= 57) && b != 46 { numeric = false } }
        if numeric {
            if !_ipv4(host) { return false }
        } else {
            if host.len() > 253 { return false }
            var start = usize(0)
            for i in 0..host.len() + 1 {
                if i == host.len() || host[i] == 46 {
                    if i == start || i - start > 63 || host[start] == 45 || host[i - 1] == 45 { return false }
                    start = i + 1
                } else {
                    b := _lower(host[i])
                    if !((b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45) { return false }
                }
            }
        }
    }
    if port < data.len() { match _decimal(&data[port..], 65535) { Some(n) => {}
                None => { return false } } }
    // A colon with an empty port is invalid.
    if data[data.len() - 1] == 58 { return false }
    return true
}
fn _forbidden_trailer(name &[]u8) bool {
    return _reserved(name) || _eq(name, "host".bytes()) || _eq(name, "expect".bytes()) || _eq(name, "authorization".bytes()) || _eq(name, "proxy-authorization".bytes()) || _eq(name, "cookie".bytes()) || _eq(name, "content-type".bytes()) || _eq(name, "content-encoding".bytes()) || _eq(name, "content-range".bytes())
}
// Validate comma-separated tokens. Used for Connection and Trailer declarations.
fn _list(data &[]u8, trailer bool) Result<bool, Error> {
    var start = usize(0)
    var close = false
    for i in 0..data.len() + 1 {
        if i == data.len() || data[i] == 44 {
            part := _trim(&data[start..i])
            if !_tokens(part) { return Err(Error.Protocol(ProtocolError.Syntax)) }
            var lower = Vec.new()
            for b in part { lower.push(_lower(b)) }
            name := lower.as_slice()
            if trailer {
                if _forbidden_trailer(name) { return Err(Error.Protocol(ProtocolError.Trailer)) }
            } else {
                if _eq(name, "close".bytes()) { close = true }
                if _eq(name, "upgrade".bytes()) { return Err(Error.Protocol(ProtocolError.Unsupported)) }
                if _forbidden_trailer(name) { return Err(Error.Protocol(ProtocolError.Framing)) }
            }
            start = i + 1
        }
    }
    return Ok(close)
}
fn _transfer(data &[]u8) Result<bool, Error> {
    var start = usize(0)
    var count = usize(0)
    var chunked = usize(0)
    for i in 0..data.len() + 1 {
        if i == data.len() || data[i] == 44 {
            part := _trim(&data[start..i])
            if !_tokens(part) { return Err(Error.Protocol(ProtocolError.Framing)) }
            count = count + 1
            if _ieq(part, "chunked".bytes()) { chunked = chunked + 1 }
            start = i + 1
        }
    }
    if chunked > 1 { return Err(Error.Protocol(ProtocolError.Framing)) }
    return Ok(count == 1 && chunked == 1)
}
fn _uri(b u8) bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 46 || b == 95 || b == 126 || b == 33 || b == 36 || b == 38 || b == 39 || b == 40 || b == 41 || b == 42 || b == 43 || b == 44 || b == 59 || b == 61 || b == 58 || b == 64 || b == 47 || b == 63 || b == 37
}
fn _header(line &[]u8) Result<Header, Error> {
    colon := _find(line, 58)
    if colon == line.len() || !_tokens(&line[..colon]) { return Err(Error.Protocol(ProtocolError.Syntax)) }
    name := try _text(&line[..colon])
    match Header.new(&name, &line[colon + 1..]) {
        Ok(h) => { return Ok(h) }
        Err(error) => { return Err(Error.Protocol(ProtocolError.Syntax)) }
    }
}
copy enum _Framing {
    Length(usize)
    Chunked
}
struct _Head {
    request Request
    framing _Framing
    close bool
}
fn _parse_head(data &[]u8, limits Limits) Result<_Head, Error> {
    if data.len() > limits.head { return Err(Error.Limit(LimitKind.Headers)) }
    var end = _find(data, 10)
    if end == data.len() || end == 0 || data[end - 1] != 13 { return Err(Error.Protocol(ProtocolError.Syntax)) }
    if end + 1 > limits.request_line { return Err(Error.Limit(LimitKind.RequestLine)) }
    line := &data[..end - 1]
    first := _find(line, 32)
    if first == line.len() || !_tokens(&line[..first]) { return Err(Error.Protocol(ProtocolError.Syntax)) }
    rest := &line[first + 1..]
    second := _find(rest, 32)
    if second == rest.len() { return Err(Error.Protocol(ProtocolError.Syntax)) }
    method := &line[..first]
    target := &rest[..second]
    version := &rest[second + 1..]
    if !_eq(version, "HTTP/1.1".bytes()) {
        if version.len() == 8 && _eq(&version[..5], "HTTP/".bytes()) && version[5] >= 48 && version[5] <= 57 && version[6] == 46 && version[7] >= 48 && version[7] <= 57 { return Err(Error.Protocol(ProtocolError.Version)) }
        return Err(Error.Protocol(ProtocolError.Syntax))
    }
    if _eq(method, "CONNECT".bytes()) { return Err(Error.Protocol(ProtocolError.Unsupported)) }
    if target.len() == 0 { return Err(Error.Protocol(ProtocolError.Syntax)) }
    if target[0] != 47 && !(_eq(method, "OPTIONS".bytes()) && _eq(target, "*".bytes())) { return Err(Error.Protocol(ProtocolError.Syntax)) }
    var i = usize(0)
    for i < target.len() {
        b := target[i]
        if !_uri(b) { return Err(Error.Protocol(ProtocolError.Syntax)) }
        if b == 37 {
            if target.len() - i < 3 || _hex(target[i + 1]) == 16 || _hex(target[i + 2]) == 16 { return Err(Error.Protocol(ProtocolError.Syntax)) }
            i = i + 2
        }
        i = i + 1
    }
    var request = Request{_method: try _text(method), _target: try _text(target), _headers: Vec.new(), _body: Vec.new(), _trailers: Vec.new()}
    var hosts = usize(0)
    var lengths = usize(0)
    var transfers = usize(0)
    var length = usize(0)
    var close = false
    var expect = false
    var unsupported = false
    var framing = _Framing.Length(0)
    var start = end + 1
    for {
        end = start
        for end < data.len() && data[end] != 10 { end = end + 1 }
        if end == data.len() || end == start || data[end - 1] != 13 { return Err(Error.Protocol(ProtocolError.Syntax)) }
        if end + 1 - start > limits.line { return Err(Error.Limit(LimitKind.Headers)) }
        if end - start == 1 {
            if end + 1 != data.len() { return Err(Error.Protocol(ProtocolError.Syntax)) }
            break
        }
        if request._headers.len() == limits.headers { return Err(Error.Limit(LimitKind.Headers)) }
        h := try _header(&data[start..end - 1])
        name := h._name.bytes()
        value := h._value.as_slice()
        if _eq(name, "host".bytes()) {
            hosts = hosts + 1
            if !_host(value) { return Err(Error.Protocol(ProtocolError.Host)) }
        }
        if _eq(name, "content-length".bytes()) {
            lengths = lengths + 1
            match _decimal(value, 18446744073709551615) {
                Some(n) => { length = n }
                None => { return Err(Error.Protocol(ProtocolError.Framing)) }
            }
        }
        if _eq(name, "transfer-encoding".bytes()) {
            transfers = transfers + 1
            if !(try _transfer(value)) { unsupported = true }
            framing = _Framing.Chunked
        }
        if _eq(name, "connection".bytes()) { if try _list(value, false) { close = true } }
        if _eq(name, "trailer".bytes()) { try _list(value, true) }
        if _eq(name, "expect".bytes()) { expect = true }
        if _eq(name, "upgrade".bytes()) { unsupported = true }
        request._headers.push(h)
        start = end + 1
    }
    if hosts != 1 { return Err(Error.Protocol(ProtocolError.Host)) }
    if lengths > 1 || transfers > 1 || (lengths != 0 && transfers != 0) { return Err(Error.Protocol(ProtocolError.Framing)) }
    if unsupported { return Err(Error.Protocol(ProtocolError.Unsupported)) }
    if expect { return Err(Error.Protocol(ProtocolError.Expect)) }
    if transfers == 0 {
        if length > limits.body { return Err(Error.Limit(LimitKind.Body)) }
        framing = _Framing.Length(length)
    }
    return Ok(_Head{request: request, framing: framing, close: close})
}

async fn _line(reader &mut net.BufferedReader, stream &mut net.TcpStream, max usize, kind LimitKind) Result<Vec<u8>, Error> {
    match await reader.read_until(stream, 10, max) {
        Ok(line) => { return Ok(line) }
        Err(error) => {
            match error.kind {
                io.ErrorKind.LimitExceeded => { return Err(Error.Limit(kind)) }
                _ => { return Err(Error.Io(error)) }
            }
        }
    }
}
fn _crlf(data &[]u8) bool {
    return data.len() >= 2 && data[data.len() - 2] == 13 && data[data.len() - 1] == 10
}
async fn _read_head(reader &mut net.BufferedReader, stream &mut net.TcpStream, limits Limits) Result<Option<_Head>, Error> {
    var bytes = Vec.new()
    first := try await _line(reader, stream, limits.request_line, LimitKind.RequestLine)
    if first.len() == 0 { return Ok(None) }
    if !_crlf(first.as_slice()) { return Err(Error.Protocol(ProtocolError.Incomplete)) }
    _append(&mut bytes, first.as_slice())
    var count = usize(0)
    for {
        line := try await _line(reader, stream, limits.line, LimitKind.Headers)
        if !_crlf(line.as_slice()) { return Err(Error.Protocol(ProtocolError.Incomplete)) }
        if line.len() > limits.head - bytes.len() { return Err(Error.Limit(LimitKind.Headers)) }
        _append(&mut bytes, line.as_slice())
        if line.len() == 2 { break }
        count = count + 1
        if count > limits.headers { return Err(Error.Limit(LimitKind.Headers)) }
    }
    return Ok(Some(try _parse_head(bytes.as_slice(), limits)))
}
struct _HeadSlot { result Result<Option<_Head>, Error> }
async fn _head_stage(reader &mut net.BufferedReader, stream &mut net.TcpStream, limits Limits, out &mut _HeadSlot) Result<void, io.Error> {
    out.result = await _read_head(reader, stream, limits)
    return Ok(())
}
// Validate extensions without interpreting their content. No quoted CR/LF.
fn _chunk_size(data &[]u8) Result<usize, Error> {
    var i = usize(0)
    var n = usize(0)
    max: usize := 18446744073709551615
    for i < data.len() && _hex(data[i]) < 16 {
        d := _hex(data[i])
        if n > (max - d) / 16 { return Err(Error.Protocol(ProtocolError.Chunk)) }
        n = n * 16 + d
        i = i + 1
    }
    if i == 0 { return Err(Error.Protocol(ProtocolError.Chunk)) }
    for i < data.len() {
        // RFC chunk extensions permit bad whitespace around separators.
        for i < data.len() && (data[i] == 32 || data[i] == 9) { i = i + 1 }
        if i == data.len() || data[i] != 59 { return Err(Error.Protocol(ProtocolError.Chunk)) }
