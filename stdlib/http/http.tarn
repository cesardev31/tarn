struct _HeadSlot { result Result<Option<_Head>, Error> }
async fn _head_stage(reader &mut net.BufferedReader, stream &mut net.TcpStream, limits Limits, out &mut _HeadSlot) Result<void, io.Error> {
    out.result = await _read_head(reader, stream, limits)
    return Ok(())
}
// Validate extensions without interpreting their content. No quoted CR/LF.
fn _chunk_size(data &[]u8) Result<usize, Error> {
    var i = usize(0)
    var n = usize(0)
    max := (usize(9223372036854775807) * usize(2) + usize(1))
    for i < data.len() && _hex(data[i]) < usize(16) {
        d := _hex(data[i])
        if n > (max - d) / usize(16) { return Err(Error.Protocol(ProtocolError.Chunk)) }
        n = n * usize(16) + d
        i = i + usize(1)
    }
    if i == usize(0) { return Err(Error.Protocol(ProtocolError.Chunk)) }
    for i < data.len() {
        // RFC chunk extensions permit bad whitespace around separators.
        for i < data.len() && (data[i] == u8(32) || data[i] == u8(9)) { i = i + usize(1) }
        if i == data.len() || data[i] != u8(59) { return Err(Error.Protocol(ProtocolError.Chunk)) }
        i = i + usize(1)
        for i < data.len() && (data[i] == u8(32) || data[i] == u8(9)) { i = i + usize(1) }
        start := i
        for i < data.len() && _token(data[i]) { i = i + usize(1) }
        if i == start { return Err(Error.Protocol(ProtocolError.Chunk)) }
        for i < data.len() && (data[i] == u8(32) || data[i] == u8(9)) { i = i + usize(1) }
        if i < data.len() && data[i] == u8(61) {
            i = i + usize(1)
            for i < data.len() && (data[i] == u8(32) || data[i] == u8(9)) { i = i + usize(1) }
            if i < data.len() && data[i] == u8(34) {
                i = i + usize(1)
                var done = false
                for i < data.len() {
                    b := data[i]
                    i = i + usize(1)
                    if b == u8(34) { done = true
                        break }
                    if b == u8(92) {
                        if i == data.len() { return Err(Error.Protocol(ProtocolError.Chunk)) }
                        b2 := data[i]
                        if (b2 < u8(32) && b2 != u8(9)) || b2 == u8(127) { return Err(Error.Protocol(ProtocolError.Chunk)) }
                        i = i + usize(1)
                    } else {
                        if (b < u8(32) && b != u8(9)) || b == u8(127) { return Err(Error.Protocol(ProtocolError.Chunk)) }
                    }
                }
                if !done { return Err(Error.Protocol(ProtocolError.Chunk)) }
            } else {
                begin := i
                for i < data.len() && _token(data[i]) { i = i + usize(1) }
                if begin == i { return Err(Error.Protocol(ProtocolError.Chunk)) }
            }
        }
        // Next iteration validates separator, including trailing whitespace.
    }
    return Ok(n)
}
async fn _exact(reader &mut net.BufferedReader, stream &mut net.TcpStream, target &mut []u8) Result<void, Error> {
    match await reader.read_exact(stream, target) {
        Ok(value) => { return Ok(()) }
        Err(error) => match error.kind {
            io.ErrorKind.UnexpectedEof => { return Err(Error.Protocol(ProtocolError.Incomplete)) }
            _ => { return Err(Error.Io(error)) }
        }
    }
}
async fn _bytes(reader &mut net.BufferedReader, stream &mut net.TcpStream, count usize, body &mut Vec<u8>) Result<void, Error> {
    start := body.len()
    for body.len() - start < count { body.push(u8(0)) }
    return await _exact(reader, stream, &mut body.as_mut_slice()[start..])
}
async fn _read_body(reader &mut net.BufferedReader, stream &mut net.TcpStream, limits Limits, head &mut _Head) Result<void, Error> {
    match head.framing {
        _Framing.Length(count) => { return await _bytes(reader, stream, count, &mut head.request._body) }
        _Framing.Chunked => {}
    }
    var metadata = usize(0)
    var chunks = usize(0)
    for {
        line := try await _line(reader, stream, limits.line, LimitKind.ChunkMetadata)
        if !_crlf(line.as_slice()) { return Err(Error.Protocol(ProtocolError.Incomplete)) }
        if line.len() > limits.chunk_metadata - metadata { return Err(Error.Limit(LimitKind.ChunkMetadata)) }
        metadata = metadata + line.len()
        count := try _chunk_size(&line.as_slice()[..line.len() - usize(2)])
        if count == usize(0) { break }
        chunks = chunks + usize(1)
        if chunks > limits.chunks { return Err(Error.Limit(LimitKind.ChunkMetadata)) }
        if count > limits.body - head.request._body.len() { return Err(Error.Limit(LimitKind.Body)) }
        try await _bytes(reader, stream, count, &mut head.request._body)
        var ending = [2]u8{0, 0}
        try await _exact(reader, stream, &mut ending[..])
        if !_crlf(&ending[..]) { return Err(Error.Protocol(ProtocolError.Chunk)) }
        if usize(2) > limits.chunk_metadata - metadata { return Err(Error.Limit(LimitKind.ChunkMetadata)) }
        metadata = metadata + usize(2)
    }
    for {
        line := try await _line(reader, stream, limits.line, LimitKind.Trailers)
        if !_crlf(line.as_slice()) { return Err(Error.Protocol(ProtocolError.Incomplete)) }
        if line.len() > limits.chunk_metadata - metadata { return Err(Error.Limit(LimitKind.ChunkMetadata)) }
        metadata = metadata + line.len()
        if line.len() == usize(2) { return Ok(()) }
        if head.request._trailers.len() == limits.trailers { return Err(Error.Limit(LimitKind.Trailers)) }
        h := try _header(&line.as_slice()[..line.len() - usize(2)])
        if _forbidden_trailer(h._name.bytes()) { return Err(Error.Protocol(ProtocolError.Trailer)) }
        head.request._trailers.push(h)
    }
}
struct _BodySlot { result Result<void, Error> }
async fn _body_stage(reader &mut net.BufferedReader, stream &mut net.TcpStream, limits Limits, head &mut _Head, out &mut _BodySlot) Result<void, io.Error> {
    out.result = await _read_body(reader, stream, limits, head)
    return Ok(())
}
fn _reason(status u16) string {
    match status {
        200 => { return "OK" }
        201 => { return "Created" }
        204 => { return "No Content" }
        205 => { return "Reset Content" }
        304 => { return "Not Modified" }
        400 => { return "Bad Request" }
        404 => { return "Not Found" }
        405 => { return "Method Not Allowed" }
        408 => { return "Request Timeout" }
        413 => { return "Content Too Large" }
        414 => { return "URI Too Long" }
        417 => { return "Expectation Failed" }
        431 => { return "Request Header Fields Too Large" }
        500 => { return "Internal Server Error" }
        501 => { return "Not Implemented" }
        505 => { return "HTTP Version Not Supported" }
        _ => { return "" }
    }
}
fn _encode(response &Response, limits Limits, head bool, close bool) Result<Vec<u8>, Error> {
    if response._status < u16(200) || response._status > u16(599) { return Err(Error.InvalidResponse) }
    forbidden := response._status == u16(204) || response._status == u16(304)
    if (forbidden || response._status == u16(205)) && response._body.len() != usize(0) { return Err(Error.InvalidResponse) }
    if response._body.len() > limits.response_body || response._headers.len() > limits.response_headers { return Err(Error.Limit(LimitKind.Response)) }
    var bytes = Vec.new()
    line := "HTTP/1.1 " + string.from_u64(u64(response._status)) + " " + _reason(response._status) + "\r\n"
    _append(&mut bytes, line.bytes())
    if !forbidden {
        length := "content-length: " + string.from_u64(u64(response._body.len())) + "\r\n"
        _append(&mut bytes, length.bytes())
    }
    if close { _append(&mut bytes, "connection: close\r\n".bytes()) }
    if bytes.len() > limits.response_head - usize(2) { return Err(Error.Limit(LimitKind.Response)) }
    for h in response._headers.as_slice() {
        if _reserved(h._name.bytes()) { return Err(Error.InvalidResponse) }
        // Header construction already validated all byte controls.
        if h._name.len() + h._value.len() + usize(4) > limits.response_head - bytes.len() { return Err(Error.Limit(LimitKind.Response)) }
        _append(&mut bytes, h._name.bytes())
        _append(&mut bytes, ": ".bytes())
        _append(&mut bytes, h._value.as_slice())
        _append(&mut bytes, "\r\n".bytes())
    }
    if bytes.len() > limits.response_head - usize(2) { return Err(Error.Limit(LimitKind.Response)) }
    _append(&mut bytes, "\r\n".bytes())
    if !head && !forbidden { _append(&mut bytes, response._body.as_slice()) }
    return Ok(bytes)
}
async fn _write(writer &mut net.BufferedWriter, stream &mut net.TcpStream, bytes &[]u8) Result<void, io.Error> {
    try await writer.write_all(stream, bytes)
    return await writer.flush(stream)
}
copy enum _State {
    Awaiting
    Ready
    Ended
    FailedBefore
    FailedDuring
}
pub struct Connection {
    stream net.TcpStream
    reader net.BufferedReader
    writer net.BufferedWriter
    limits Limits
    timeouts Timeouts
    state _State
    head bool
    _close bool
    count usize
}
pub fn Connection.new(stream net.TcpStream, limits Limits, timeouts Timeouts) Result<Connection, Error> {
    if !_config_valid(limits, timeouts) { return Err(Error.InvalidConfig) }
    var socket = stream
    match socket.set_nonblocking(true) { Err(e) => { return Err(Error.Io(e)) }
        Ok(value) => {} }
    return Ok(Connection{stream: socket, reader: net.BufferedReader.new(limits.buffer), writer: net.BufferedWriter.new(limits.buffer), limits: limits, timeouts: timeouts, state: _State.Awaiting, head: false, _close: false, count: usize(0)})
}
pub async fn Connection.read_request(&mut self, owner &runtime.Execution) Result<Option<Request>, Error> {
    match self.state { _State.Ended => { return Ok(None) }
        _State.Awaiting => {}
        _ => { return Err(Error.InvalidState) } }
    // Abandonment leaves the protocol unusable but does not change ownership.
    self.state = _State.FailedBefore
    var slot = _HeadSlot{result: Ok(None)}
    operation := runtime.Operation.new(owner, _head_stage(&mut self.reader, &mut self.stream, self.limits, &mut slot))
    match await runtime.run_timeout(operation, self.timeouts.head) {
        Err(e) => { return Err(Error.Io(e)) }
        Ok(done) => { if !done { return Err(Error.Timeout(Stage.Head)) } }
    }
    var parsed: _Head
    match try slot.result {
        None => { self.state = _State.Ended
            return Ok(None) }
        Some(value) => { parsed = value }
    }
    var body = _BodySlot{result: Ok(())}
    body_operation := runtime.Operation.new(owner, _body_stage(&mut self.reader, &mut self.stream, self.limits, &mut parsed, &mut body))
    match await runtime.run_timeout(body_operation, self.timeouts.body) {
        Err(e) => { return Err(Error.Io(e)) }
        Ok(done) => { if !done { return Err(Error.Timeout(Stage.Body)) } }
    }
    try body.result
    self.head = _eq(parsed.request._method.bytes(), "HEAD".bytes())
    self._close = parsed.close
    self.state = _State.Ready
    self.count = self.count + usize(1)
    return Ok(Some(parsed.request))
}
pub async fn Connection.write_response(&mut self, owner &runtime.Execution, response Response) Result<void, Error> {
    match self.state { _State.Ready => {}
        _ => { return Err(Error.InvalidState) } }
    close := self._close || response.close || self.count >= self.limits.requests
    bytes := try _encode(&response, self.limits, self.head, close)
    self.state = _State.FailedDuring
    operation := runtime.Operation.new(owner, _write(&mut self.writer, &mut self.stream, bytes.as_slice()))
    match await runtime.run_timeout(operation, self.timeouts.write) {
        Err(e) => { return Err(Error.Io(e)) }
        Ok(done) => { if !done { return Err(Error.Timeout(Stage.Write)) } }
    }
    self.state = _State.Awaiting
    if close { self.state = _State.Ended }
    return Ok(())
}
pub async fn Connection.reject(&mut self, owner &runtime.Execution, status u16) Result<void, Error> {
    if status < u16(400) || status > u16(599) { return Err(Error.InvalidResponse) }
    match self.state {
        _State.Awaiting => {}
        _State.Ready => {}
        _State.FailedBefore => {}
        _ => { return Err(Error.InvalidState) }
    }
    response := try Response.bytes(status, Vec.new())
    bytes := try _encode(&response, self.limits, false, true)
    self.state = _State.FailedDuring
    operation := runtime.Operation.new(owner, _write(&mut self.writer, &mut self.stream, bytes.as_slice()))
    match await runtime.run_timeout(operation, self.timeouts.write) {
        Err(e) => { return Err(Error.Io(e)) }
        Ok(done) => { if !done { return Err(Error.Timeout(Stage.Write)) } }
    }
    self.state = _State.Ended
    return Ok(())
}
pub fn Connection.close(self) Result<void, Error> {
    match self.stream.close() { Ok(value) => { return Ok(()) }
        Err(e) => { return Err(Error.Io(e)) } }
}

/// Serve `address` until a listener error, calling `handler` once per request.
///
/// Connections are handled one at a time on a private Execution owned by this
/// call, so the handler may mutably borrow application state without
/// synchronization. Each response closes its connection: a sequential server
/// must not let one idle keep-alive client delay every other client. A handler
/// Err is answered with its status (500 for I/O and construction errors).
/// Use Connection directly for concurrent tasks or keep-alive control.
pub fn serve(address &string, handler mut fn(&Request) Result<Response, Error>) Result<void, io.Error> {
    var listener = try net.TcpListener.bind(address)
    try listener.set_nonblocking(true)
    var callback = handler
    execution := try runtime.Execution.new()
    var operation = runtime.Operation.new(&execution, _serve(listener, &execution, &mut callback))
    try try execution.block_on(&mut operation)
    return Ok(())
}
async fn _serve(listener net.TcpListener, owner &runtime.Execution, handler &mut mut fn(&Request) Result<Response, Error>) Result<void, io.Error> {
    var socket = listener
    for {
        stream := try await socket.accept_async()
        match Connection.new(stream, Limits.defaults(), Timeouts.defaults()) {
            Ok(connection) => { await _answer(connection, owner, handler) }
            Err(error) => {}
        }
    }
}
/// One request and its response; protocol failures are rejected and transport
/// failures end the connection without a response.
async fn _answer(connection Connection, owner &runtime.Execution, handler &mut mut fn(&Request) Result<Response, Error>) {
    var conn = connection
    var request: Request
    received := await conn.read_request(owner)
    match received {
        Ok(result) => match result {
            Some(value) => { request = value }
            None => { return }
        }
        Err(error) => {
            match error {
                Error.Io(original) => { return }
                _ => {}
            }
            await conn.reject(owner, error.status())
            return
        }
    }
    match handler(&request) {
        Ok(response) => { await conn.write_response(owner, response.close_connection()) }
        Err(error) => {
            var status = error.status()
            if status < 400 { status = 500 }
            await conn.reject(owner, status)
        }
    }
}
