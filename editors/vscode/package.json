{
  "name": "tarn",
  "displayName": "Tarn",
  "description": "Official Tarn language support",
  "publisher": "tarn-lang",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tarn",
        "aliases": [
          "Tarn",
          "tarn"
        ],
        "extensions": [
          ".tarn"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tarn-file.svg",
          "dark": "./icons/tarn-file.svg"
        }
      },
      {
        "id": "tarn-diag",
        "aliases": [
          "Tarn Diagnostics"
        ],
        "extensions": [
          ".diag"
        ],
        "icon": {
          "light": "./icons/tarn-diag.svg",
          "dark": "./icons/tarn-diag.svg"
        },
        "configuration": "./artifact-configuration.json"
      },
      {
        "id": "tarn-res",
        "aliases": [
          "Tarn Resolution"
        ],
        "extensions": [],
        "icon": {
          "light": "./icons/tarn-res.svg",
          "dark": "./icons/tarn-res.svg"
        },
        "configuration": "./artifact-configuration.json",
        "firstLine": "^== "
      },
      {
        "id": "tarn-ast",
        "aliases": [
          "Tarn AST"
        ],
        "extensions": [
          ".ast"
        ],
        "icon": {
          "light": "./icons/tarn-ast.svg",
          "dark": "./icons/tarn-ast.svg"
        },
        "configuration": "./artifact-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tarn",
        "scopeName": "source.tarn",
        "path": "./syntaxes/tarn.tmLanguage.json"
      },
      {
        "language": "tarn-diag",
        "scopeName": "source.tarn-diag",
        "path": "./syntaxes/tarn-diag.tmLanguage.json"
      },
      {
        "language": "tarn-res",
        "scopeName": "source.tarn-res",
        "path": "./syntaxes/tarn-res.tmLanguage.json"
      },
      {
        "language": "tarn-ast",
        "scopeName": "source.tarn-ast",
        "path": "./syntaxes/tarn-ast.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tarn.restartServer",
        "title": "Tarn: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Tarn",
      "properties": {
        "tarn.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to tarn-lsp. Relative paths resolve against the workspace. Empty searches workspace/extension checkout targets, then PATH. Changes restart the server."
        },
        "tarn.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable compiler diagnostics, navigation and formatting. Changes take effect immediately; highlighting and snippets remain available when disabled."
        }
      }
    },
    "snippets": [
      {
        "language": "tarn",
        "path": "./snippets/tarn.json"
      }
    ]
  },
  "icon": "icons/tarn.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tarn"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "test": "node tests/run.cjs"
  }
}
